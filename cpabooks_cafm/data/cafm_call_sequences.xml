<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_cpabooks_cafm_amc_call" model="ir.sequence">
            <field name="name">CAFM AMC Call</field>
            <field name="code">cpabooks.cafm.amc.call</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_cpabooks_cafm_var_qt" model="ir.sequence">
            <field name="name">CAFM VAR Quotation</field>
            <field name="code">cpabooks.cafm.var.qt</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_cpabooks_cafm_stock_issue_amc" model="ir.sequence">
            <field name="name">CAFM AMC Stock Issue</field>
            <field name="code">cpabooks.cafm.stock.issue.amc</field>
            <field name="prefix">AMCSI/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="sequence_cpabooks_cafm_stock_issue_var" model="ir.sequence">
            <field name="name">CAFM VAR Stock Issue</field>
            <field name="code">cpabooks.cafm.stock.issue.var</field>
            <field name="prefix">VARSI/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="sequence_cpabooks_cafm_stock_transfer" model="ir.sequence">
            <field name="name">CAFM Stock Transfer</field>
            <field name="code">cpabooks.cafm.stock.transfer</field>
            <field name="prefix">ST/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="sequence_cpabooks_cafm_stock_receipt" model="ir.sequence">
            <field name="name">CAFM Stock Receipt</field>
            <field name="code">cpabooks.cafm.stock.receipt</field>
            <field name="prefix">SRN/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
