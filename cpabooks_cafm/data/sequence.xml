<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="sequence_cpabooks_cafm_contract" model="ir.sequence">
            <field name="name">CAFM AMC Contract</field>
            <field name="code">cpabooks.cafm.contract</field>
            <field name="prefix">AMC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>

        <record id="sequence_cpabooks_cafm_contract_order" model="ir.sequence">
            <field name="name">CAFM Contract Order</field>
            <field name="code">cpabooks.cafm.contract.order</field>
            <field name="sequence_for">cafm_contract_order</field>
            <field name="prefix">CO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="sequence_pattern">year_yearly</field>
        </record>
    </data>
</odoo>
