<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="CpabooksCafmDashboard">
        <div class="cfd_root">
            <div class="cfd_shell">
                <section class="cfd_hero">
                    <div>
                        <div class="cfd_eyebrow">cpabooks_cafm</div>
                        <h1 class="cfd_title" id="cfd_title">CAFM Dashboard</h1>
                        <p class="cfd_subtitle" id="cfd_subtitle"></p>
                    </div>
                    <div class="cfd_badge" id="cfd_badge"></div>
                </section>

                <section class="cfd_kpi_grid" id="cfd_kpi_grid"></section>

                <section class="cfd_chart_grid">
                    <article class="cfd_card">
                        <div class="cfd_card_head">
                            <h2>AMC Status Mix</h2>
                            <span class="cfd_card_suffix">Contract health</span>
                        </div>
                        <div class="cfd_chart_wrap">
                            <canvas id="cfd_chart_amc_status"></canvas>
                        </div>
                    </article>

                    <article class="cfd_card">
                        <div class="cfd_card_head">
                            <h2>Revenue by Project</h2>
                            <span class="cfd_card_suffix">Yearly vs monthly</span>
                        </div>
                        <div class="cfd_chart_wrap">
                            <canvas id="cfd_chart_project_value"></canvas>
                        </div>
                    </article>
                </section>

                <section class="cfd_chart_grid">
                    <article class="cfd_card">
                        <div class="cfd_card_head">
                            <h2>PPM Frequency Mix</h2>
                            <span class="cfd_card_suffix">Preventive cadence</span>
                        </div>
                        <div class="cfd_chart_wrap">
                            <canvas id="cfd_chart_ppm_frequency"></canvas>
                        </div>
                    </article>

                    <article class="cfd_card">
                        <div class="cfd_card_head">
                            <h2>Unit Type Mix</h2>
                            <span class="cfd_card_suffix">Portfolio structure</span>
                        </div>
                        <div class="cfd_chart_wrap">
                            <canvas id="cfd_chart_unit_mix"></canvas>
                        </div>
                    </article>
                </section>

                <section class="cfd_secondary_grid">
                    <article class="cfd_card">
                        <div class="cfd_card_head">
                            <h2>Top Projects</h2>
                            <span class="cfd_card_suffix">Highest contract concentration</span>
                        </div>
                        <div class="cfd_table_wrap">
                            <table class="cfd_table">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Project</th>
                                        <th class="cfd_num">Yearly Value</th>
                                        <th class="cfd_num">Monthly Revenue</th>
                                        <th class="cfd_num">Units</th>
                                        <th class="cfd_num">Calls</th>
                                    </tr>
                                </thead>
                                <tbody id="cfd_top_projects_body"></tbody>
                            </table>
                        </div>
                    </article>

                    <article class="cfd_card">
                        <div class="cfd_card_head">
                            <h2>Expiring Contracts</h2>
                            <span class="cfd_card_suffix">Next 90 days</span>
                        </div>
                        <div class="cfd_table_wrap">
                            <table class="cfd_table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Customer</th>
                                        <th>Expiry</th>
                                        <th class="cfd_num">Days Left</th>
                                        <th class="cfd_num">Invoice Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="cfd_expiring_body"></tbody>
                            </table>
                        </div>
                    </article>
                </section>

                <article class="cfd_card">
                    <div class="cfd_card_head">
                        <h2>Busiest Units</h2>
                        <span class="cfd_card_suffix">Service intensity by villa / flat</span>
                    </div>
                    <div class="cfd_table_wrap">
                        <table class="cfd_table">
                            <thead>
                                <tr>
                                    <th>Unit</th>
                                    <th>Project</th>
                                    <th class="cfd_num">Calls</th>
                                    <th class="cfd_num">Yearly Value</th>
                                    <th class="cfd_num">Monthly Revenue</th>
                                </tr>
                            </thead>
                            <tbody id="cfd_busy_units_body"></tbody>
                        </table>
                    </div>
                </article>

                <article class="cfd_card">
                    <div class="cfd_card_head">
                        <h2>Management Notes</h2>
                        <span class="cfd_card_suffix">Quick focus areas</span>
                    </div>
                    <div class="cfd_focus_grid" id="cfd_focus_cards"></div>
                </article>
            </div>
        </div>
    </t>
</templates>
