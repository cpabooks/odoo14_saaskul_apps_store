<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpabooks_cafm_priority_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.priority.tree</field>
        <field name="model">cpabooks.cafm.priority</field>
        <field name="arch" type="xml">
            <tree editable="bottom" class="o_cafm_tally_tree">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_master_simple_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.master.simple.tree</field>
        <field name="model">cpabooks.cafm.job.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom" class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_work_type_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.work.type.tree</field>
        <field name="model">cpabooks.cafm.work.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom" class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_problem_reported_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.problem.reported.tree</field>
        <field name="model">cpabooks.cafm.problem.reported</field>
        <field name="arch" type="xml">
            <tree editable="bottom" class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_client_manager_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.client.manager.tree</field>
        <field name="model">cpabooks.cafm.client.manager</field>
        <field name="arch" type="xml">
            <tree class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="user_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_client_manager_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.client.manager.form</field>
        <field name="model">cpabooks.cafm.client.manager</field>
        <field name="arch" type="xml">
            <form string="Client Manager" class="o_cafm_tally_form">
                <sheet>
                    <div class="o_cafm_tally_title_block">Client Manager</div>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="mobile"/>
                        <field name="email"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cpabooks_cafm_technician_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.technician.tree</field>
        <field name="model">cpabooks.cafm.technician</field>
        <field name="arch" type="xml">
            <tree class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="mobile"/>
                <field name="user_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_technician_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.technician.form</field>
        <field name="model">cpabooks.cafm.technician</field>
        <field name="arch" type="xml">
            <form string="Technician" class="o_cafm_tally_form">
                <sheet>
                    <div class="o_cafm_tally_title_block">Technician</div>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="mobile"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cpabooks_cafm_department_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.department.tree</field>
        <field name="model">cpabooks.cafm.department</field>
        <field name="arch" type="xml">
            <tree class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_department_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.department.form</field>
        <field name="model">cpabooks.cafm.department</field>
        <field name="arch" type="xml">
            <form string="Department Security" class="o_cafm_tally_form">
                <sheet>
                    <div class="o_cafm_tally_title_block">Department Security</div>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group string="Access">
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="project_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cpabooks_cafm_priority" model="ir.actions.act_window">
        <field name="name">Priority</field>
        <field name="res_model">cpabooks.cafm.priority</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_job_type" model="ir.actions.act_window">
        <field name="name">Type of Job</field>
        <field name="res_model">cpabooks.cafm.job.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_work_type" model="ir.actions.act_window">
        <field name="name">Type of Work</field>
        <field name="res_model">cpabooks.cafm.work.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_problem_reported" model="ir.actions.act_window">
        <field name="name">Problem Reported</field>
        <field name="res_model">cpabooks.cafm.problem.reported</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_client_managers" model="ir.actions.act_window">
        <field name="name">Client Managers</field>
        <field name="res_model">cpabooks.cafm.client.manager</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_technicians" model="ir.actions.act_window">
        <field name="name">Technicians</field>
        <field name="res_model">cpabooks.cafm.technician</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_departments" model="ir.actions.act_window">
        <field name="name">Department Security</field>
        <field name="res_model">cpabooks.cafm.department</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_cpabooks_cafm_clients" model="ir.actions.act_window">
        <field name="name">Client</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
    </record>
</odoo>
