<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Contract master tree (form / export / reports) -->
        <record id="view_cpabooks_cafm_amc_contract_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.tree</field>
            <field name="model">cpabooks.cafm.contract</field>
            <field name="arch" type="xml">
                <tree decoration-danger="contract_status == 'expired'"
                      decoration-warning="contract_status == 'pending'"
                      decoration-muted="contract_status == 'cancelled'">
                    <field name="name" string="Contract"/>
                    <field name="client_id" string="Client Name"/>
                    <field name="project_id" string="Project Name"/>
                    <field name="next_invoice_month" string="Next Invoice"/>
                    <field name="invoice_frequency"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="yearly_contract_amount" string="Yearly Amount" sum="Yearly"/>
                    <field name="monthly_revenue" string="Monthly Amount" sum="Monthly"/>
                    <field name="invoicing_value" string="Next Invoice Amount" sum="Next Inv. Amt"/>
                    <field name="total_contract_value" string="Cont. Amount" sum="Cont. Amount"/>
                    <field name="contract_status" string="Status"/>
                </tree>
            </field>
        </record>

        <!-- AMC Invoice Register list: core columns + optional (3-dots) register fields -->
        <record id="view_cpabooks_cafm_amc_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.month.line.tree</field>
            <field name="model">cpabooks.cafm.contract.month.line</field>
            <field name="arch" type="xml">
                <tree js_class="cafm_amc_register_list"
                      class="o_cafm_amc_register_tree o_cafm_amc_amount_list"
                      create="false" edit="false" delete="1"
                      decoration-danger="contract_status == 'expired'"
                      decoration-warning="contract_status == 'pending'"
                      decoration-muted="contract_status == 'cancelled'"
                      default_order="month_sort, name">
                    <field name="contract_id" invisible="1"/>
                    <field name="month_key" invisible="1"/>
                    <field name="month_sort" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <button name="action_open_contract" type="object" string="Open" icon="fa-external-link" class="btn-link"/>
                    <field name="name" string="Contract"/>
                    <field name="client_id" string="Client Name"/>
                    <field name="project_id" string="Project Name"/>
                    <field name="yearly_contract_amount" string="Yearly Amount"/>
                    <field name="monthly_revenue" string="Monthly Amount" sum="Total"/>
                    <field name="invoicing_value" string="Next Invoice Amount" sum="Total"/>
                    <field name="total_contract_value" string="Cont. Amount"/>
                    <!-- Optional columns (3-dots) — hidden by default -->
                    <field name="month_label" string="Next Invoice" optional="hide"/>
                    <field name="serial_no" optional="hide"/>
                    <field name="ubs_no" optional="hide"/>
                    <field name="business_unit" optional="hide"/>
                    <field name="customer_group_id" optional="hide"/>
                    <field name="customer_trn" optional="hide"/>
                    <field name="contact_person_id" optional="hide"/>
                    <field name="contact_no" optional="hide"/>
                    <field name="client_manager_id" optional="hide"/>
                    <field name="gfs_supervisor_id" optional="hide"/>
                    <field name="gfs_admin_id" optional="hide"/>
                    <field name="unit_id" optional="hide"/>
                    <field name="project_location_id" optional="hide"/>
                    <field name="location" optional="hide"/>
                    <field name="amc_contract_type" optional="hide"/>
                    <field name="contract_date" optional="hide"/>
                    <field name="contract_expiry" optional="hide"/>
                    <field name="renewal_date" optional="hide"/>
                    <field name="contract_period_years" optional="hide"/>
                    <field name="invoice_frequency" optional="hide"/>
                    <field name="next_invoice_month" optional="hide"/>
                    <field name="last_invoiced_date" optional="hide"/>
                    <field name="invoice_update_status" optional="hide"/>
                    <field name="contract_check_status" optional="hide"/>
                    <field name="live_status" optional="hide"/>
                    <field name="verifying_date" optional="hide"/>
                    <field name="contract_status" string="Status" optional="hide"/>
                    <field name="quarterly_amount" optional="hide"/>
                    <field name="number_of_flats" optional="hide"/>
                    <field name="remarks" optional="hide"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_amc_month_line_search" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.month.line.search</field>
            <field name="model">cpabooks.cafm.contract.month.line</field>
            <field name="arch" type="xml">
                <search string="AMC Invoice Register">
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="project_id"/>
                    <field name="month_label"/>
                    <field name="contract_id"/>
                    <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                    <group expand="1" string="Group By">
                        <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                        <filter name="group_customer_group" string="Client Group" context="{'group_by': 'customer_group_id'}"/>
                        <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_cpabooks_cafm_amc_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.form</field>
            <field name="model">cpabooks.cafm.contract</field>
            <field name="arch" type="xml">
                <form string="AMC Contract">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm / Activate" class="btn-primary" attrs="{'invisible': [('contract_status', '=', 'active')]}"/>
                        <button name="action_set_pending" type="object" string="Set Pending" attrs="{'invisible': [('contract_status', 'in', ['pending', 'cancelled'])]}"/>
                        <button name="action_set_draft" type="object" string="Set to Draft" attrs="{'invisible': [('contract_status', '=', 'draft')]}"/>
                        <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible': [('contract_status', '=', 'cancelled')]}"/>
                        <field name="contract_status" widget="statusbar" statusbar_visible="draft,active,pending,expired,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-building" attrs="{'invisible': [('project_id', '=', False)]}">
                                <span>Project</span>
                            </button>
                            <button name="action_open_unit" type="object" class="oe_stat_button" icon="fa-home" attrs="{'invisible': [('unit_id', '=', False)]}">
                                <span>Villa / Flat</span>
                            </button>
                            <button name="action_view_contract_orders" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="contract_order_count" string="Cont. Orders" widget="statinfo"/>
                            </button>
                            <button name="action_create_contract_orders"
                                    type="object"
                                    string="Create All Contracts Order"
                                    class="btn-primary"/>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Customer / Project">
                                <field name="serial_no"/>
                                <field name="client_id"/>
                                <field name="ubs_no"/>
                                <field name="business_unit"/>
                                <field name="customer_group_id"/>
                                <field name="customer_trn"/>
                                <field name="contact_person_id"/>
                                <field name="contact_no"/>
                                <field name="client_manager_id" context="{'cafm_quick_user': 1, 'form_view_ref': 'cpabooks_cafm.view_users_simple_form_cafm_optional_email'}"/>
                                <field name="gfs_supervisor_id" context="{'cafm_quick_user': 1, 'form_view_ref': 'cpabooks_cafm.view_users_simple_form_cafm_optional_email'}"/>
                                <field name="gfs_admin_id" context="{'cafm_quick_user': 1, 'form_view_ref': 'cpabooks_cafm.view_users_simple_form_cafm_optional_email'}"/>
                                <field name="project_id"/>
                                <field name="unit_id" invisible="1"/>
                                <field name="unit_contract_type" string="Villa / Flat"/>
                                <field name="location"/>
                                <field name="project_location_id"/>
                            </group>
                            <group string="Contract">
                                <field name="amc_contract_type"/>
                                <field name="contract_date"/>
                                <field name="contract_expiry"/>
                                <field name="contract_period_years"/>
                                <field name="renewal_date"/>
                                <field name="live_status"/>
                                <field name="contract_check_status"/>
                                <field name="verifying_date"/>
                            </group>
                        </group>
                        <group string="Invoicing Follow-up">
                            <group>
                                <field name="last_invoiced_date"/>
                                <field name="next_invoice_month" placeholder="Mar, Jun, Sep, Dec"/>
                                <field name="invoice_month_tag_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                            <group>
                                <field name="invoice_update_status"/>
                            </group>
                        </group>
                        <group string="Commercial">
                            <field name="currency_id" invisible="1"/>
                            <group>
                                <field name="invoice_frequency"/>
                                <field name="yearly_contract_amount" readonly="1"/>
                                <field name="monthly_revenue" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_contract_value" widget="monetary"/>
                                <field name="quarterly_amount" readonly="1"/>
                                <field name="invoicing_value" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="schedule_total" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Operational Quantities" col="4">
                            <field name="number_of_flats"/>
                            <field name="rate_per_flat_yearly" readonly="1"/>
                            <field name="rate_per_flat_monthly" readonly="1"/>
                            <field name="sqft_qty"/>
                            <field name="sqft_rate" readonly="1"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="priority" widget="priority"/>
                            <field name="active"/>
                        </group>
                        <group string="Remarks">
                            <field name="remarks" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Contract Orders">
                                <group col="4">
                                    <field name="invoicing_date" string="Invoice Date"/>
                                    <button name="action_create_contract_orders" type="object" string="Create Cont. Order" class="btn-primary"/>
                                    <button name="action_clear_contract_orders" type="object" string="Clear Cont. Order" class="btn-secondary" confirm="This will delete uninvoiced contract orders. Continue?"/>
                                </group>
                                <field name="contract_order_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="period_label"/>
                                        <field name="date_from"/>
                                        <field name="date_to"/>
                                        <field name="invoice_date"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="invoice_id"/>
                                        <field name="state"/>
                                        <button name="action_create_invoice" type="object" string="Create Invoice" attrs="{'invisible': [('invoice_id', '!=', False)]}"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Villa / Flat">
                                <group col="4">
                                    <button name="action_generate_flat_villa_lines" type="object" string="Generate Villa / Flat" class="btn-primary"/>
                                    <button name="action_clear_flat_villa_lines" type="object" string="Clear Villa / Flat" class="btn-secondary" confirm="This will delete all Villa / Flat lines. Continue?"/>
                                </group>
                                <field name="flat_detail_ids" context="{'default_contract_id': active_id, 'default_contract_type': unit_contract_type}">
                                    <tree editable="bottom" delete="1" create="1">
                                        <field name="sequence" string="Sr. No."/>
                                        <field name="contract_type"/>
                                        <field name="flat_code"/>
                                        <field name="flat_name"/>
                                        <field name="tenant_unit_id"
                                                  string="Tenant Name"
                                                  options="{'no_quick_create': True}"
                                                  context="{
                                                      'form_view_ref': 'cpabooks_cafm.view_cpabooks_cafm_unit_form',
                                                      'default_project_id': parent.project_id,
                                                      'default_unit_type': contract_type,
                                                  }"/>
                                        <field name="contact_mobile"/>
                                        <button name="action_generate_flat_details" type="object" string="Add"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Contract Copy / Documents">
                                <field name="document_line_ids">
                                    <tree editable="bottom" create="1" delete="1">
                                        <field name="sequence" string="Serial"/>
                                        <field name="name"/>
                                        <field name="attachment" filename="attachment_filename"/>
                                        <field name="attachment_filename" invisible="1"/>
                                        <field name="note"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                            <page string="Audit / Additional Info">
                                <group>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                    <field name="state_change_date" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_search" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.search</field>
            <field name="model">cpabooks.cafm.contract</field>
            <field name="arch" type="xml">
                <search string="AMC Contracts">
                    <!-- Single keyword box: no per-field search facet list -->
                    <field name="name" string="Keyword"
                             filter_domain="['|','|','|','|','|','|','|','|','|','|','|',
                                ('name','ilike',self),
                                ('ubs_no','ilike',self),
                                ('business_unit','ilike',self),
                                ('location','ilike',self),
                                ('client_id','ilike',self),
                                ('project_id','ilike',self),
                                ('customer_group_id','ilike',self),
                                ('contact_no','ilike',self),
                                ('contract_check_status','ilike',self),
                                ('project_location_id','ilike',self),
                                ('notes','ilike',self),
                                ('remarks','ilike',self)]"/>
                    <filter name="filter_active" string="Active" domain="[('contract_status', '=', 'active')]"/>
                    <filter name="filter_live" string="Live" domain="[('live_status', '=', 'live')]"/>
                    <filter name="filter_non_live" string="Non Live" domain="[('live_status', '=', 'non_live')]"/>
                    <filter name="filter_auto_renewed" string="Auto Renewed - No Cont. Copy" domain="[('contract_check_status', '=', 'auto_renewed_no_copy')]"/>
                    <filter name="filter_check_verified" string="check &amp; verified" domain="[('contract_check_status', '=', 'check_verified')]"/>
                    <filter name="filter_pending" string="Pending" domain="[('contract_status', '=', 'pending')]"/>
                    <filter name="filter_expired" string="Expired" domain="[('contract_status', '=', 'expired')]"/>
                    <filter name="filter_cancelled" string="Cancelled" domain="[('contract_status', '=', 'cancelled')]"/>
                    <separator/>
                    <filter name="filter_monthly" string="Monthly" domain="[('invoice_frequency', '=', 'monthly')]"/>
                    <filter name="filter_quarterly" string="Quarterly" domain="[('invoice_frequency', '=', 'quarterly')]"/>
                    <filter name="filter_half_yearly" string="Half Yearly" domain="[('invoice_frequency', '=', 'half_yearly')]"/>
                    <filter name="filter_annually" string="Annually" domain="[('invoice_frequency', '=', 'annually')]"/>
                    <separator/>
                    <filter name="filter_expiring_this_month" string="Expiring This Month" date="contract_expiry" default_period="this_month"/>
                    <filter name="filter_renewal_due" string="Renewal Due" domain="[('renewal_date', '&lt;=', context_today())]"/>
                    <filter name="filter_my_company" string="My Company" domain="[('company_id', 'in', allowed_company_ids)]"/>
                    <group expand="1" string="Group By">
                        <filter name="group_next_invoice" string="Next Invoice" context="{'group_by': 'next_invoice_label'}"/>
                        <filter name="group_next_invoice_period" string="Next Invoice (Period)" context="{'group_by': 'next_invoice_period'}"/>
                        <filter name="group_next_invoice_raw" string="Next Invoice (raw)" context="{'group_by': 'next_invoice_month'}"/>
                        <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                        <filter name="group_customer_group" string="Client Group" context="{'group_by': 'customer_group_id'}"/>
                        <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                        <filter name="group_location" string="Location" context="{'group_by': 'project_location_id'}"/>
                        <filter name="group_frequency" string="Invoice Frequency" context="{'group_by': 'invoice_frequency'}"/>
                        <filter name="group_status" string="Status" context="{'group_by': 'contract_status'}"/>
                        <filter name="group_period" string="Contract Period" context="{'group_by': 'contract_period_years'}"/>
                        <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                        <filter name="group_renewal_month" string="Renewal Month" context="{'group_by': 'renewal_date:month'}"/>
                        <filter name="group_expiry_month" string="Expiry Month" context="{'group_by': 'contract_expiry:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_pivot" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.pivot</field>
            <field name="model">cpabooks.cafm.contract</field>
            <field name="arch" type="xml">
                <pivot string="AMC Contract Analysis">
                    <field name="client_id" type="row"/>
                    <field name="project_id" type="row"/>
                    <field name="invoice_frequency" type="col"/>
                    <field name="contract_status" type="col"/>
                    <field name="total_contract_value" type="measure"/>
                    <field name="yearly_contract_amount" type="measure"/>
                    <field name="monthly_revenue" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_graph" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.graph</field>
            <field name="model">cpabooks.cafm.contract</field>
            <field name="arch" type="xml">
                <graph string="AMC Contract Values" type="bar">
                    <field name="client_id"/>
                    <field name="total_contract_value" type="measure"/>
                    <field name="yearly_contract_amount" type="measure"/>
                    <field name="monthly_revenue" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="action_cpabooks_cafm_amc_x_view" model="ir.actions.client">
            <field name="name">AMC Revenue X View</field>
            <field name="tag">cpabooks_cafm_amc_x_view</field>
            <field name="target">current</field>
        </record>

        <record id="action_cpabooks_cafm_amc" model="ir.actions.act_window">
            <field name="name">AMC Invoice Register</field>
            <field name="res_model">cpabooks.cafm.contract.month.line</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_cpabooks_cafm_amc_tree"/>
            <field name="search_view_id" ref="view_cpabooks_cafm_amc_month_line_search"/>
            <field name="domain">[('active', '=', True)]</field>
            <field name="context">{
                'import_enabled': True,
            }</field>
        </record>

        <record id="action_cpabooks_cafm_amc_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_cpabooks_cafm_amc_tree"/>
            <field name="act_window_id" ref="action_cpabooks_cafm_amc"/>
        </record>

        <!-- Explicit Action → Delete (1 or many selected AMC contracts) -->
        <record id="action_server_cafm_amc_register_delete" model="ir.actions.server">
            <field name="name">Delete</field>
            <field name="sequence" eval="1"/>
            <field name="model_id" ref="model_cpabooks_cafm_contract_month_line"/>
            <field name="binding_model_id" ref="model_cpabooks_cafm_contract_month_line"/>
            <field name="binding_type">action</field>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if not records:
    raise UserError('Select at least one AMC contract line to delete.')
records.unlink()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
            </field>
        </record>

        <!-- List Action menu: month popup print (not form Print dropdown) -->
        <record id="action_server_cafm_amc_print_next_invoice" model="ir.actions.server">
            <field name="name">Print AMC Contracts To be Invoiced</field>
            <field name="sequence" eval="20"/>
            <field name="model_id" ref="model_cpabooks_cafm_contract_month_line"/>
            <field name="binding_model_id" ref="model_cpabooks_cafm_contract_month_line"/>
            <field name="binding_type">action</field>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = env['cpabooks.cafm.contract'].action_open_next_invoice_print_wizard(
    list(env.context.get('active_domain') or [])
)
            </field>
        </record>

        <record id="action_cpabooks_cafm_amc_report" model="ir.actions.act_window">
            <field name="name">AMC Reports</field>
            <field name="res_model">cpabooks.cafm.contract</field>
            <field name="view_mode">pivot,graph,tree,form</field>
            <field name="search_view_id" ref="view_cpabooks_cafm_contract_search"/>
        </record>

        <record id="action_cpabooks_cafm_amc_export" model="ir.actions.act_window">
            <field name="name">Export AMC Contracts</field>
            <field name="res_model">cpabooks.cafm.contract</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_cpabooks_cafm_contract_search"/>
            <field name="context">{'import_enabled': True}</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_amc"
                  name="AMC Invoicing"
                  parent="menu_cpabooks_cafm_root"
                  sequence="5"/>

        <menuitem id="menu_cpabooks_cafm_amc_register"
                  name="AMC Invoice Register"
                  parent="menu_cpabooks_cafm_amc"
                  action="action_cpabooks_cafm_amc"
                  sequence="1"/>

        <record id="menu_cpabooks_cafm_amc_contracts" model="ir.ui.menu">
            <field name="name">AMC Contracts</field>
            <field name="parent_id" ref="menu_cpabooks_cafm_root"/>
            <field name="active" eval="False"/>
        </record>

        <menuitem id="menu_cpabooks_cafm_reports"
                  name="AMC Reports"
                  parent="menu_cpabooks_cafm_root"
                  action="action_cpabooks_cafm_amc_report"
                  sequence="30"/>

        <menuitem id="menu_cpabooks_cafm_amc_export"
                  name="Export AMC Contracts"
                  parent="menu_cpabooks_cafm_tools"
                  action="action_cpabooks_cafm_amc_export"
                  sequence="3"/>
    </data>
</odoo>
