<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cpabooks_cafm_ppm_slot_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.ppm.slot.tree</field>
        <field name="model">cpabooks.cafm.ppm.slot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ppm_id"/>
                <field name="project_id"/>
                <field name="year"/>
                <field name="month"/>
                <field name="state"/>
                <field name="maintenance_request_id"/>
            </tree>
        </field>
    </record>

    <record id="view_cpabooks_cafm_ppm_slot_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.ppm.slot.form</field>
        <field name="model">cpabooks.cafm.ppm.slot</field>
        <field name="arch" type="xml">
            <form string="PPM month">
                <header>
                    <button name="action_create_request" type="object" string="Create service call" class="btn-primary"
                            attrs="{'invisible': [('maintenance_request_id', '!=', False)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ppm_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="unit_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="maintenance_request_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cpabooks_cafm_ppm_slot_search" model="ir.ui.view">
        <field name="name">cpabooks.cafm.ppm.slot.search</field>
        <field name="model">cpabooks.cafm.ppm.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="ppm_id"/>
                <field name="project_id"/>
                <filter name="filter_planned" string="Planned" domain="[('state','=','planned')]"/>
                <filter name="filter_done" string="Done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_year" context="{'group_by':'year'}"/>
                    <filter name="group_month" context="{'group_by':'month'}"/>
                    <filter name="group_project" context="{'group_by':'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cpabooks_cafm_ppm_slot" model="ir.actions.act_window">
        <field name="name">PPM month slots</field>
        <field name="res_model">cpabooks.cafm.ppm.slot</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_planned': 1}</field>
    </record>
</odoo>
