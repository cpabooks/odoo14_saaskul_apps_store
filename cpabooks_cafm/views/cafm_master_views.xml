<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_cpabooks_cafm_location_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.location.tree</field>
            <field name="model">cpabooks.cafm.location</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_location_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.location.form</field>
            <field name="model">cpabooks.cafm.location</field>
            <field name="arch" type="xml">
                <form string="CAFM Location">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_locations" model="ir.actions.act_window">
            <field name="name">Locations</field>
            <field name="res_model">cpabooks.cafm.location</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_locations"
                  name="Location Master"
                  parent="menu_cpabooks_cafm_configuration"
                  action="action_cpabooks_cafm_locations"
                  sequence="10"/>

        <record id="view_cpabooks_cafm_contact_person_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contact.person.tree</field>
            <field name="model">cpabooks.cafm.contact.person</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="mobile"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contact_person_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contact.person.form</field>
            <field name="model">cpabooks.cafm.contact.person</field>
            <field name="arch" type="xml">
                <form string="Contact Person">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="mobile"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_contact_persons" model="ir.actions.act_window">
            <field name="name">Contact Persons</field>
            <field name="res_model">cpabooks.cafm.contact.person</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_contact_persons"
                  name="Contact Persons"
                  parent="menu_cpabooks_cafm_configuration"
                  action="action_cpabooks_cafm_contact_persons"
                  sequence="20"/>

        <record id="view_cpabooks_cafm_customer_group_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.customer.group.tree</field>
            <field name="model">cpabooks.cafm.customer.group</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_customer_group_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.customer.group.form</field>
            <field name="model">cpabooks.cafm.customer.group</field>
            <field name="arch" type="xml">
                <form string="Customer Group">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_customer_groups" model="ir.actions.act_window">
            <field name="name">Customer Groups</field>
            <field name="res_model">cpabooks.cafm.customer.group</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_customer_groups"
                  name="Customer Groups"
                  parent="menu_cpabooks_cafm_configuration"
                  action="action_cpabooks_cafm_customer_groups"
                  sequence="30"/>
    </data>
</odoo>
