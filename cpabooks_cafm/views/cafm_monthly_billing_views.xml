<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cafm_monthly_billing_wizard_form_view" model="ir.ui.view">
        <field name="name">cafm.monthly.billing.wizard.form</field>
        <field name="model">cafm.monthly.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Billing" create="false" edit="true">
                <header>
                    <button name="action_apply" type="object" string="Apply" class="oe_highlight"/>
                    <button name="action_reset_period" type="object" string="Reset Period"/>
                    <button name="action_toggle_unfold_projects" type="object"
                            string="Toggle: Unfold projects"
                            help="Show or hide project subtotals under every customer. You can still expand one customer by clicking its row."/>
                    <button name="action_toggle_unfold_orders" type="object"
                            string="Toggle: Unfold orders"
                            help="Show or hide contract order lines under projects (turns on project level as well)."/>
                    <button name="action_export_table" type="object" string="Export Table"/>
                </header>
                <sheet>
                    <field name="billing_scope" invisible="1"/>
                    <group col="4">
                        <field name="period_start"/>
                        <field name="view_mode"/>
                        <field name="hierarchy_all_projects" invisible="1"/>
                        <field name="hierarchy_all_orders" invisible="1"/>
                    </group>
                    <field name="report_html" widget="cafm_readonly_html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cafm_monthly_billing_invoiced_server" model="ir.actions.server">
        <field name="name">Monthly Billing Table - Invoiced</field>
        <field name="model_id" ref="model_cafm_monthly_billing_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_invoiced()</field>
    </record>

    <record id="cafm_monthly_billing_pending_server" model="ir.actions.server">
        <field name="name">Monthly Billing Table</field>
        <field name="model_id" ref="model_cafm_monthly_billing_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pending()</field>
    </record>

    <!-- Main table = billed + unbilled in the same client row -->
    <menuitem id="menu_cpabooks_cafm_monthly_billing_table"
              name="Monthly Billing Table"
              parent="menu_cpabooks_cafm_amc"
              action="cafm_monthly_billing_pending_server"
              sequence="15"/>

    <menuitem id="menu_cpabooks_cafm_monthly_billing_pending"
              name="Monthly Billing Table - Invoiced"
              parent="menu_cpabooks_cafm_amc"
              action="cafm_monthly_billing_invoiced_server"
              sequence="16"/>
</odoo>
