<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cpabooks_cafm_pending_invoice_wizard_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.pending.invoice.wizard.form</field>
        <field name="model">cpabooks.cafm.pending.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Pending Invoice">
                <sheet>
                    <div class="mb16">
                        <span class="text-muted">
                            Create customer invoices from uninvoiced contract orders for the period you set (Start → Until).
                            Leave Client / Project / Client Group empty to include all.
                            Default period is the current calendar year; change as needed.
                            <br/><br/>
                            Invoices stay in draft — review and post from Invoice.
                            Existing invoices are not changed.
                            <br/>
                            <b>Create New Invoices</b> — only contracts that have never been invoiced.
                            <br/>
                            <b>Create Missed Invoices</b> — all matching uninvoiced orders in the period
                            (keep existing invoices; fill remaining).
                        </span>
                    </div>
                    <group>
                        <group string="Filters (empty = All)">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="customer_group_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Creation Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create_new_invoices" type="object"
                                string="Create New Invoices" class="btn-primary"/>
                        <button name="action_create_missed_invoices" type="object"
                                string="Create Missed Invoices" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cpabooks_cafm_pending_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Create Pending Invoice</field>
        <field name="res_model">cpabooks.cafm.pending.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cpabooks_cafm_pending_invoice_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cpabooks_cafm_pending_invoices"
              name="Create Pending Invoice"
              parent="menu_cpabooks_cafm_amc"
              action="action_cpabooks_cafm_pending_invoice_wizard"
              sequence="21"/>
</odoo>
