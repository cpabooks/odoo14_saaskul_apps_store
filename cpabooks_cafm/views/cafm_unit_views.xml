<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_cpabooks_cafm_unit_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.unit.tree</field>
            <field name="model">cpabooks.cafm.unit</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="parent_id"/>
                    <field name="unit_type"/>
                    <field name="owner_id"/>
                    <field name="yearly_value"/>
                    <field name="monthly_value"/>
                    <field name="request_count"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_unit_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.unit.form</field>
            <field name="model">cpabooks.cafm.unit</field>
            <field name="arch" type="xml">
                <form string="Villa / Flat">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_child_units" type="object" class="oe_stat_button" icon="fa-sitemap">
                                <field name="child_count" string="Child Units" widget="statinfo"/>
                            </button>
                            <button name="action_view_unit_amc" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="amc_count" string="AMC" widget="statinfo"/>
                            </button>
                            <button name="action_view_unit_ppm" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="ppm_count" string="PPM" widget="statinfo"/>
                            </button>
                            <button name="action_view_unit_requests" type="object" class="oe_stat_button" icon="fa-wrench">
                                <field name="request_count" string="Calls" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                            <div><field name="code"/></div>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="parent_id" domain="[('project_id', '=', project_id)]"/>
                                <field name="unit_type"/>
                            </group>
                            <group>
                                <field name="owner_id"/>
                                <field name="tenant_partner_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                        <notebook>
                            <page string="Child Units">
                                <field name="child_ids">
                                    <tree editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="unit_type"/>
                                        <field name="owner_id"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="AMC Contracts">
                                <field name="amc_ids" context="{'default_project_id': project_id, 'default_unit_id': active_id}">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="client_id"/>
                                        <field name="invoice_frequency"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="total_contract_value" widget="monetary"/>
                                        <field name="contract_date"/>
                                        <field name="contract_expiry"/>
                                        <field name="yearly_contract_amount"/>
                                        <field name="monthly_revenue"/>
                                        <field name="invoicing_value"/>
                                        <field name="contract_status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="PPM">
                                <field name="ppm_ids" context="{'default_project_id': project_id, 'default_unit_id': active_id}">
                                    <tree>
                                        <field name="name"/>
                                        <field name="service_type"/>
                                        <field name="frequency"/>
                                        <field name="next_due_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Service Calls">
                                <field name="request_ids">
                                    <tree>
                                        <field name="ticket_no"/>
                                        <field name="name"/>
                                        <field name="work_type"/>
                                        <field name="problem"/>
                                        <field name="request_date"/>
                                        <field name="stage_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_units" model="ir.actions.act_window">
            <field name="name">Units</field>
            <field name="res_model">cpabooks.cafm.unit</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_units"
                  name="Villa / Flat Register"
                  parent="menu_cpabooks_cafm_operations"
                  action="action_cpabooks_cafm_units"
                  sequence="2"/>
    </data>
</odoo>
