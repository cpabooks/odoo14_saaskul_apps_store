<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cafm_amc_next_invoice_print_wizard_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.amc.next.invoice.print.wizard.form</field>
        <field name="model">cpabooks.cafm.amc.next.invoice.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print AMC Contracts To be Invoiced">
                <group>
                    <group string="Next Invoice (default)">
                        <field name="month_key"
                                 string="Next Invoice Month"
                                 options="{'no_create': True, 'no_open': True}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Filter print (optional)">
                        <field name="client_id" string="Client wise" options="{'no_create': True}"/>
                        <field name="customer_group_id" string="Client Group wise" options="{'no_create': True}"/>
                        <field name="project_id" string="Project wise" options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Default selects <b>Next Invoice</b> month (current month when available).
                    Optionally filter by Client, Client Group, or Project before Print.
                </div>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
