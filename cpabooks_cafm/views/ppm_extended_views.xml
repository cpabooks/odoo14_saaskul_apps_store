<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cpabooks_cafm_ppm_tree_ext" model="ir.ui.view">
        <field name="name">cpabooks.cafm.ppm.tree.planning</field>
        <field name="model">cpabooks.cafm.ppm</field>
        <field name="inherit_id" ref="cpabooks_cafm.view_cpabooks_cafm_ppm_tree"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="supervisor_id" optional="show"/>
                <field name="planning_mode" optional="hide"/>
            </field>
            <field name="frequency" position="after">
                <field name="slot_planned_count" string="Planned slots"/>
                <field name="slot_done_count" string="Done slots"/>
            </field>
        </field>
    </record>

    <record id="view_cpabooks_cafm_ppm_form_ext" model="ir.ui.view">
        <field name="name">cpabooks.cafm.ppm.form.planning</field>
        <field name="model">cpabooks.cafm.ppm</field>
        <field name="inherit_id" ref="cpabooks_cafm.view_cpabooks_cafm_ppm_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_slots" type="object" string="Month slots" class="btn-secondary"/>
                <button name="action_generate_slots_current_year" type="object" string="Regenerate current year"
                        confirm="This rebuilds all month slots for the current calendar year from the planning rules. Continue?"/>
            </xpath>
            <field name="frequency" position="after">
                <field name="planning_mode"/>
                <field name="supervisor_id"/>
            </field>
            <xpath expr="//field[@name='note']/.." position="before">
                <group string="Manual months" attrs="{'invisible': [('planning_mode', '!=', 'manual')]}">
                    <group>
                        <field name="manual_jan"/>
                        <field name="manual_feb"/>
                        <field name="manual_mar"/>
                        <field name="manual_apr"/>
                    </group>
                    <group>
                        <field name="manual_may"/>
                        <field name="manual_jun"/>
                        <field name="manual_jul"/>
                        <field name="manual_aug"/>
                    </group>
                    <group>
                        <field name="manual_sep"/>
                        <field name="manual_oct"/>
                        <field name="manual_nov"/>
                        <field name="manual_dec"/>
                    </group>
                </group>
                <group>
                    <field name="slot_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="ppm_id" invisible="1"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="state"/>
                            <field name="maintenance_request_id"/>
                            <field name="note"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
