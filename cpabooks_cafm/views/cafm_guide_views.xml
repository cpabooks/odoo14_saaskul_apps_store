<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Combined How-it-works pages (vertical + round on one screen) -->
        <record id="action_cafm_how_amc" model="ir.actions.client">
            <field name="name">Process Flow AMC</field>
            <field name="tag">cpabooks_cafm_how_amc</field>
            <field name="context">{'cafm_path': 'amc'}</field>
        </record>
        <record id="action_cafm_how_var" model="ir.actions.client">
            <field name="name">Process Flow VAR</field>
            <field name="tag">cpabooks_cafm_how_var</field>
            <field name="context">{'cafm_path': 'var'}</field>
        </record>

        <!-- Client actions kept for compatibility (same combined page) -->
        <record id="action_cafm_amc_flowchart" model="ir.actions.client">
            <field name="name">Process Flow AMC</field>
            <field name="tag">cpabooks_cafm_how_amc</field>
            <field name="context">{'cafm_path': 'amc'}</field>
        </record>
        <record id="action_cafm_var_flowchart" model="ir.actions.client">
            <field name="name">Process Flow VAR</field>
            <field name="tag">cpabooks_cafm_how_var</field>
            <field name="context">{'cafm_path': 'var'}</field>
        </record>
        <record id="action_cafm_amc_cycle" model="ir.actions.client">
            <field name="name">Process Flow AMC</field>
            <field name="tag">cpabooks_cafm_how_amc</field>
            <field name="context">{'cafm_path': 'amc'}</field>
        </record>
        <record id="action_cafm_var_cycle" model="ir.actions.client">
            <field name="name">Process Flow VAR</field>
            <field name="tag">cpabooks_cafm_how_var</field>
            <field name="context">{'cafm_path': 'var'}</field>
        </record>
        <record id="action_cafm_organogram" model="ir.actions.client">
            <field name="name">Process Flow AMC</field>
            <field name="tag">cpabooks_cafm_how_amc</field>
            <field name="context">{'cafm_path': 'amc'}</field>
        </record>
        <record id="action_cafm_process_cycle" model="ir.actions.client">
            <field name="name">Process Flow VAR</field>
            <field name="tag">cpabooks_cafm_how_var</field>
            <field name="context">{'cafm_path': 'var'}</field>
        </record>

        <!-- Wizard form -->
        <record id="view_cafm_amc_wizard_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.amc.wizard.form</field>
            <field name="model">cpabooks.cafm.amc.wizard</field>
            <field name="arch" type="xml">
                <form string="AMC / VAR Wizard">
                    <sheet>
                        <div class="oe_title">
                            <h1>AMC / VAR Wizard</h1>
                            <p attrs="{'invisible': [('path_type', '!=', False)]}">
                                Choose AMC or VAR — each step has Create and Open.
                            </p>
                        </div>

                        <group string="Process Path">
                            <field name="path_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="step_index" invisible="1"/>
                            <field name="step_key" invisible="1"/>
                        </group>

                        <div class="o_cafm_wizard_3d_row" attrs="{'invisible': [('path_type', '!=', False)]}">
                            <button name="action_choose_amc" type="object" string="AMC"
                                    class="o_cafm_btn_3d o_cafm_btn_3d_amc"/>
                            <button name="action_choose_var" type="object" string="VAR (no AMC)"
                                    class="o_cafm_btn_3d o_cafm_btn_3d_var"/>
                        </div>

                        <group attrs="{'invisible': [('path_type', '=', False)]}">
                            <field name="progress_label" readonly="1" string="Progress"/>
                            <field name="step_title" readonly="1" string="Current step"/>
                            <field name="step_help" readonly="1" nolabel="1" colspan="2"/>
                        </group>

                        <group string="Context (optional)"
                               attrs="{'invisible': [('path_type', '=', False)]}">
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="contract_id"
                                      attrs="{'invisible': [('path_type', '!=', 'amc')]}"/>
                            <field name="sale_order_id"
                                      attrs="{'invisible': [('path_type', '!=', 'var')]}"/>
                            <field name="priority_id"
                                      attrs="{'invisible': ['|', ('path_type', '!=', 'amc'), ('step_key', '!=', 'sla')]}"/>
                        </group>

                        <div class="o_cafm_wizard_actions"
                             attrs="{'invisible': [('path_type', '=', False)]}">
                            <button name="action_create_step" type="object"
                                    string="Create" class="btn-primary oe_highlight"/>
                            <button name="action_open_step" type="object"
                                    string="Open" class="btn-secondary"/>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_back" type="object" string="Back"
                                attrs="{'invisible': [('path_type', '=', False)]}"/>
                        <button name="action_next" type="object" string="Next" class="oe_highlight"
                                attrs="{'invisible': [('path_type', '=', False)]}"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cafm_amc_wizard" model="ir.actions.act_window">
            <field name="name">AMC / VAR Wizard</field>
            <field name="res_model">cpabooks.cafm.amc.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_cafm_amc_wizard_form"/>
        </record>

        <!-- Exactly two How-it-works menus (reuse early xml ids so navbar updates) -->
        <record id="menu_cafm_guide_organogram" model="ir.ui.menu">
            <field name="name">Process Flow AMC</field>
            <field name="parent_id" ref="menu_cafm_dashboard_folder"/>
            <field name="action" ref="action_cafm_how_amc"/>
            <field name="sequence">2</field>
            <field name="active" eval="True"/>
        </record>
        <record id="menu_cafm_guide_process_cycle" model="ir.ui.menu">
            <field name="name">Process Flow VAR</field>
            <field name="parent_id" ref="menu_cafm_dashboard_folder"/>
            <field name="action" ref="action_cafm_how_var"/>
            <field name="sequence">3</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Keep split-menu xml ids inactive (avoid orphan / duplicate nav) -->
        <menuitem id="menu_cafm_guide_amc_flowchart"
                  name="AMC Flow Chart"
                  parent="menu_cafm_dashboard_folder"
                  action="action_cafm_how_amc"
                  sequence="20"
                  active="False"/>
        <menuitem id="menu_cafm_guide_var_flowchart"
                  name="VAR Flow Chart"
                  parent="menu_cafm_dashboard_folder"
                  action="action_cafm_how_var"
                  sequence="21"
                  active="False"/>
        <menuitem id="menu_cafm_guide_amc_cycle"
                  name="AMC Process Cycle"
                  parent="menu_cafm_dashboard_folder"
                  action="action_cafm_how_amc"
                  sequence="22"
                  active="False"/>
        <menuitem id="menu_cafm_guide_var_cycle"
                  name="VAR Process Cycle"
                  parent="menu_cafm_dashboard_folder"
                  action="action_cafm_how_var"
                  sequence="23"
                  active="False"/>

        <menuitem id="menu_cafm_guide_amc_wizard"
                  name="AMC / VAR Wizard"
                  parent="menu_cafm_dashboard_folder"
                  action="action_cafm_amc_wizard"
                  sequence="6"/>
    </data>
</odoo>
