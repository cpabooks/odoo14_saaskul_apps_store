<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_cpabooks_cafm_sample_loader_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.sample.loader.form</field>
            <field name="model">cpabooks.cafm.sample.loader</field>
            <field name="arch" type="xml">
                <form string="Demo Data">
                    <sheet>
                        <div class="oe_title">
                            <h1>CAFM Demo / Sample Data</h1>
                        </div>
                        <group>
                            <p colspan="2">
                                Loads <strong>18 records per voucher type</strong>
                                (AMC Register, AMC Call, VAR Work, each Stock type, PPM, projects, units, tenants).
                                All rows tagged <code>[CAFM-DEMO]</code>.
                            </p>
                        </group>
                        <footer>
                            <button string="Load Demo Data"
                                    type="object"
                                    name="action_load_demo_data"
                                    class="btn-primary"/>
                            <button string="Clean Demo Data"
                                    type="object"
                                    name="action_clean_demo_data"
                                    class="btn-secondary"/>
                            <button special="cancel" string="Close" class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_sample_loader" model="ir.actions.act_window">
            <field name="name">Load Demo Data</field>
            <field name="res_model">cpabooks.cafm.sample.loader</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_demo_data_config"
                  name="Load Demo Data"
                  parent="menu_cpabooks_cafm_configuration"
                  action="action_cpabooks_cafm_sample_loader"
                  sequence="99"/>
    </data>
</odoo>
