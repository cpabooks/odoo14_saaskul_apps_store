<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_maintenance_request_tree_inherit_cpabooks_cafm" model="ir.ui.view">
            <field name="name">maintenance.request.tree.cpabooks.cafm</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="ticket_no"/>
                    <field name="cafm_project_id"/>
                    <field name="cafm_unit_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_maintenance_request_form_cpabooks_cafm" model="ir.ui.view">
            <field name="name">maintenance.request.form.cpabooks.cafm</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='employee_id']" position="before">
                    <field name="ticket_no" readonly="1"/>
                    <field name="tenant_id"/>
                    <field name="partner_id"/>
                </xpath>
                <xpath expr="//form/sheet/group" position="inside">
                    <group string="CAFM Details">
                        <group>
                            <field name="cafm_project_id"/>
                            <field name="cafm_unit_id" domain="[('project_id', '=', cafm_project_id)]"/>
                            <field name="ppm_id" domain="[('project_id', '=', cafm_project_id)]"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="building"/>
                            <field name="flat"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <group string="Service Detail">
                        <group>
                            <field name="work_type"/>
                            <field name="problem"/>
                        </group>
                        <group>
                            <field name="property"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="action_cpabooks_cafm_tickets" model="ir.actions.act_window">
            <field name="name">Service Calls</field>
            <field name="res_model">maintenance.request</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_tickets"
                  name="Service Calls"
                  parent="menu_cpabooks_cafm_operations"
                  action="action_cpabooks_cafm_tickets"
                  sequence="5"/>
    </data>
</odoo>
