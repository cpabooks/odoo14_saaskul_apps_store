<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_maintenance_tenant_tree" model="ir.ui.view">
            <field name="name">view.maintenance.tenant.tree</field>
            <field name="model">maintenance.tenant</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="mobile" widget="phone"/>
                    <field name="email" widget="email"/>
                    <field name="project_id"/>
                    <field name="cafm_unit_id"/>
                </tree>
            </field>
        </record>

        <record id="view_maintenance_tenant_form" model="ir.ui.view">
            <field name="name">view.maintenance.tenant.form</field>
            <field name="model">maintenance.tenant</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Tenant / Occupant" nolabel="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="email" widget="email"/>
                                <field name="mobile" widget="phone"/>
                            </group>
                            <group>
                                <field name="project_id"/>
                                <field name="cafm_unit_id" domain="[('project_id', '=', project_id)]"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_maintenance_tenant" model="ir.actions.act_window">
            <field name="name">Tenants / Occupants</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">maintenance.tenant</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_tenants"
                  name="Tenants / Occupants"
                  parent="menu_cpabooks_cafm_configuration"
                  action="action_maintenance_tenant"
                  sequence="1"/>
    </data>
</odoo>
