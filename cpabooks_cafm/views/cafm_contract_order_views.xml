<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_cpabooks_cafm_contract_order_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.tree</field>
            <field name="model">cpabooks.cafm.contract.order</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'invoiced'" decoration-warning="state == 'draft'">
                    <field name="name"/>
                    <field name="contract_id"/>
                    <field name="project_id" optional="show"/>
                    <field name="partner_id"/>
                    <field name="period_label"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="invoice_date"/>
                    <field name="amount" sum="Total"/>
                    <field name="invoice_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_order_pending_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.pending.tree</field>
            <field name="model">cpabooks.cafm.contract.order</field>
            <field name="arch" type="xml">
                <tree string="Pending AMC Orders to Invoice"
                      decoration-danger="invoice_due_bucket == 'Overdue'"
                      decoration-warning="invoice_due_bucket == 'To Invoice This Month'"
                      decoration-success="state == 'order'">
                    <field name="invoice_due_bucket"/>
                    <field name="invoice_date"/>
                    <field name="name"/>
                    <field name="contract_id"/>
                    <field name="partner_id"/>
                    <field name="period_label"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="amount" sum="Total"/>
                    <field name="state"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    <field name="currency_id" optional="hide" groups="base.group_multi_currency"/>
                    <field name="notes" optional="hide"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_order_pending_search" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.pending.search</field>
            <field name="model">cpabooks.cafm.contract.order</field>
            <field name="arch" type="xml">
                <search string="Pending AMC Orders to Invoice">
                    <field name="name"/>
                    <field name="contract_id"/>
                    <field name="partner_id"/>
                    <field name="period_label"/>
                    <field name="invoice_date"/>
                    <filter name="filter_pending_to_invoice" string="Pending to Invoice" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order'])]"/>
                    <separator/>
                    <filter name="filter_overdue_previous_months" string="Overdue Previous Months" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                    <filter name="filter_this_month" string="To Invoice This Month" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_next_month_1" string="To Invoice Next Month" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=2)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_next_month_2" string="To Invoice +2 Months" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(months=2)).strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=3)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_next_month_3" string="To Invoice +3 Months" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(months=3)).strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=4)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_next_month_4" string="To Invoice +4 Months" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(months=4)).strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=5)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_next_month_5" string="To Invoice +5 Months" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(months=5)).strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=6)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_next_month_6" string="To Invoice +6 Months" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(months=6)).strftime('%Y-%m-01')), ('invoice_date', '&lt;', (context_today() + relativedelta(months=7)).strftime('%Y-%m-01'))]"/>
                    <filter name="filter_future_year" string="Future Year Clubbed" domain="[('invoice_id', '=', False), ('state', 'in', ['draft', 'order']), ('invoice_date', '&gt;=', (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_invoice_month" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                        <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                        <filter name="group_contract" string="AMC Contract" context="{'group_by': 'contract_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_order_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.form</field>
            <field name="model">cpabooks.cafm.contract.order</field>
            <field name="arch" type="xml">
                <form string="Contract Order">
                    <header>
                        <button name="action_print_contract_order" type="object" string="Print" class="btn-secondary"/>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" attrs="{'invisible': [('state', '=', 'invoiced')]}"/>
                        <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible': [('state', 'in', ['cancelled', 'invoiced'])]}"/>
                        <button name="action_set_draft" type="object" string="Set to Draft" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,order,invoiced,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object"
                                    class="oe_stat_button" icon="fa-pencil-square-o"
                                    attrs="{'invisible': [('invoice_id', '=', False)]}">
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="invoice_display_ref" nolabel="1" readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Invoice</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Order">
                                <field name="contract_id"/>
                                <field name="partner_id"/>
                                <field name="date_order"/>
                                <field name="invoice_date"/>
                                <field name="period_label"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="amount"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Customer / Project">
                                <field name="customer_group_id"/>
                                <field name="customer_trn"/>
                                <field name="contact_person_id"/>
                                <field name="contact_no"/>
                                <field name="client_manager_id"/>
                                <field name="gfs_supervisor_id"/>
                                <field name="gfs_admin_id"/>
                                <field name="project_id"/>
                                <field name="unit_id"/>
                                <field name="project_location_id"/>
                                <field name="location_area_text"/>
                                <field name="amc_contract_type"/>
                                <field name="contract_date"/>
                                <field name="contract_expiry"/>
                            </group>
                        </group>
                        <group>
                            <field name="invoice_id" invisible="1"/>
                            <field name="style" groups="base.group_no_one"/>
                            <field name="docs_status"/>
                            <field name="notes"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_contract_orders" model="ir.actions.act_window">
            <field name="name">Contract Orders</field>
            <field name="res_model">cpabooks.cafm.contract.order</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_cpabooks_cafm_contract_order_generate_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.generate.form</field>
            <field name="model">cpabooks.cafm.contract.order.generate</field>
            <field name="arch" type="xml">
                <form string="Generate Contract Orders">
                    <sheet>
                        <group>
                            <field name="generate_for"/>
                            <field name="project_id" attrs="{'invisible': [('generate_for', '!=', 'project')], 'required': [('generate_for', '=', 'project')]}"/>
                            <field name="customer_id" attrs="{'invisible': [('generate_for', '!=', 'customer')], 'required': [('generate_for', '=', 'customer')]}"/>
                            <field name="contract_id" attrs="{'invisible': [('generate_for', '!=', 'contract')], 'required': [('generate_for', '=', 'contract')]}"/>
                        </group>
                        <footer>
                            <button name="action_generate_contract_orders" type="object" string="Generate Contract Orders" class="btn-primary"/>
                            <button special="cancel" string="Cancel" class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_contract_order_generate" model="ir.actions.act_window">
            <field name="name">Generate Contract Orders</field>
            <field name="res_model">cpabooks.cafm.contract.order.generate</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_cpabooks_cafm_contract_order_generate_form"/>
            <field name="target">new</field>
        </record>

        <record id="action_cpabooks_cafm_pending_orders_to_invoice" model="ir.actions.act_window">
            <field name="name">Check Pending AMC Orders to Invoice</field>
            <field name="res_model">cpabooks.cafm.contract.order</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_cpabooks_cafm_contract_order_pending_tree"/>
            <field name="search_view_id" ref="view_cpabooks_cafm_contract_order_pending_search"/>
            <field name="domain">[('invoice_id', '=', False), ('state', 'in', ['draft', 'order'])]</field>
            <field name="context">{'search_default_group_invoice_month': 1}</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_contract_orders"
                  name="Contract Orders"
                  parent="menu_cpabooks_cafm_root"
                  sequence="7"/>

        <menuitem id="menu_cpabooks_cafm_contract_order_register"
                  name="Contract Order Register"
                  parent="menu_cpabooks_cafm_contract_orders"
                  action="action_cpabooks_cafm_contract_orders"
                  sequence="1"/>

        <menuitem id="menu_cpabooks_cafm_contract_order_generate"
                  name="Generate Contract Orders"
                  parent="menu_cpabooks_cafm_contract_orders"
                  action="action_cpabooks_cafm_contract_order_generate"
                  sequence="5"/>

        <menuitem id="menu_cpabooks_cafm_pending_orders_to_invoice"
                  name="Check Pending AMC Orders to Invoice"
                  parent="menu_cpabooks_cafm_contract_orders"
                  action="action_cpabooks_cafm_pending_orders_to_invoice"
                  sequence="10"/>

        <record id="view_cpabooks_cafm_contract_order_overdue_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.overdue.tree</field>
            <field name="model">cpabooks.cafm.contract.order</field>
            <field name="arch" type="xml">
                <tree string="Overdues AMC Pending Invoices"
                      create="false"
                      decoration-danger="is_overdue_amc_pending">
                    <field name="property_name" string="Property Name"/>
                    <field name="amc_period_display" string="AMC Period"/>
                    <field name="partner_id" string="Client"/>
                    <field name="billing_month_label" string="Month"/>
                    <field name="invoice_display_ref" string="Invoice No."/>
                    <field name="docs_status" string="Docs Status"/>
                    <field name="invoice_submission_status" string="Invoice Status"/>
                    <field name="amount" string="Amount" sum="Total"/>
                    <field name="client_manager_id" string="Client Manager"/>
                    <field name="gfs_supervisor_id" string="GFS Supervisor" optional="show"/>
                    <field name="gfs_admin_id" string="GFS Admin" optional="show"/>
                    <field name="project_location_id" optional="hide"/>
                    <field name="location_area_text" optional="hide"/>
                    <field name="project_id" optional="hide"/>
                    <field name="contract_id" string="AMC Contract" optional="hide"/>
                    <field name="name" string="Contract Order" optional="hide"/>
                    <field name="invoice_due_bucket" optional="hide"/>
                    <field name="invoice_date" optional="hide"/>
                    <field name="state" optional="hide"/>
                    <field name="is_overdue_amc_pending" invisible="1"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_contract_order_overdue_search" model="ir.ui.view">
            <field name="name">cpabooks.cafm.contract.order.overdue.search</field>
            <field name="model">cpabooks.cafm.contract.order</field>
            <field name="arch" type="xml">
                <search string="Overdues AMC Pending Invoices">
                    <field name="property_name"/>
                    <field name="partner_id"/>
                    <field name="contract_id"/>
                    <field name="project_id"/>
                    <field name="project_location_id"/>
                    <field name="location_area_text"/>
                    <field name="name"/>
                    <field name="invoice_display_ref"/>
                    <field name="client_manager_id"/>
                    <field name="gfs_supervisor_id"/>
                    <field name="gfs_admin_id"/>
                    <filter name="filter_overdue_pending_only" string="Overdue pending only" domain="[('is_overdue_amc_pending', '=', True)]"/>
                    <filter name="filter_waiting_docs" string="Waiting for docs" domain="[('docs_status', '=', 'waiting')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_project_location" string="Project Location" context="{'group_by': 'project_location_id'}"/>
                        <filter name="group_location_area" string="Location (area)" context="{'group_by': 'location_area_text'}"/>
                        <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                        <filter name="group_contract_order_no" string="Contract Order" context="{'group_by': 'name'}"/>
                        <filter name="group_amc_contract" string="AMC Contract" context="{'group_by': 'contract_id'}"/>
                        <filter name="group_invoice_month" string="Billing month" context="{'group_by': 'billing_month_label'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_cpabooks_cafm_overdue_amc_pending_invoices" model="ir.actions.act_window">
            <field name="name">Overdues AMC Pending Invoices</field>
            <field name="res_model">cpabooks.cafm.contract.order</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_cpabooks_cafm_contract_order_overdue_tree"/>
            <field name="search_view_id" ref="view_cpabooks_cafm_contract_order_overdue_search"/>
            <field name="domain">[('invoice_id', '=', False), ('state', 'in', ['draft', 'order'])]</field>
            <field name="context">{'search_default_filter_overdue_pending_only': 1}</field>
        </record>

        <menuitem id="menu_cpabooks_cafm_overdue_amc_pending_invoices"
                  name="Overdues AMC Pending Invoices"
                  parent="menu_cpabooks_cafm_contract_orders"
                  action="action_cpabooks_cafm_overdue_amc_pending_invoices"
                  sequence="15"/>
    </data>
</odoo>
