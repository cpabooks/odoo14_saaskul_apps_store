<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_project_project_cafm_tree" model="ir.ui.view">
            <field name="name">project.project.cafm.tree</field>
            <field name="model">project.project</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="cafm_code"/>
                    <field name="name"/>
                    <field name="cafm_location"/>
                    <field name="cafm_service_partner_id"/>
                    <field name="cafm_unit_count"/>
                    <field name="cafm_contract_count"/>
                    <field name="cafm_yearly_value"/>
                    <field name="cafm_monthly_value"/>
                    <field name="cafm_ticket_count"/>
                </tree>
            </field>
        </record>

        <record id="view_project_project_cafm_form" model="ir.ui.view">
            <field name="name">project.project.cafm.form</field>
            <field name="model">project.project</field>
            <field name="arch" type="xml">
                <form string="CAFM Project">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_cafm_units" type="object" class="oe_stat_button" icon="fa-building">
                                <field name="cafm_unit_count" string="Units" widget="statinfo"/>
                            </button>
                            <button name="action_view_cafm_amc" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="cafm_contract_count" string="AMC" widget="statinfo"/>
                            </button>
                            <button name="action_view_cafm_ppm" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="cafm_ppm_count" string="PPM" widget="statinfo"/>
                            </button>
                            <button name="action_view_cafm_requests" type="object" class="oe_stat_button" icon="fa-wrench">
                                <field name="cafm_ticket_count" string="Calls" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                            <div><field name="cafm_code" placeholder="Project Code"/></div>
                        </div>
                        <group>
                            <group>
                                <field name="cafm_location"/>
                                <field name="cafm_service_partner_id"/>
                            </group>
                            <group>
                                <field name="cafm_unit_count" readonly="1"/>
                                <field name="cafm_contract_count" readonly="1"/>
                                <field name="cafm_ticket_count" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="cafm_contract_detail"/>
                        </group>
                        <notebook>
                            <page string="Units">
                                <field name="cafm_unit_ids" context="{'default_project_id': active_id}">
                                    <tree editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="unit_type"/>
                                        <field name="parent_id"/>
                                        <field name="owner_id"/>
                                        <field name="yearly_value" readonly="1"/>
                                        <field name="monthly_value" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="AMC Contracts">
                                <field name="cafm_amc_ids" context="{'default_project_id': active_id}">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="client_id"/>
                                        <field name="invoice_frequency"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="total_contract_value" widget="monetary"/>
                                        <field name="contract_date"/>
                                        <field name="contract_expiry"/>
                                        <field name="yearly_contract_amount"/>
                                        <field name="monthly_revenue"/>
                                        <field name="invoicing_value"/>
                                        <field name="contract_status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="PPM">
                                <field name="cafm_ppm_ids" context="{'default_project_id': active_id}">
                                    <tree>
                                        <field name="name"/>
                                        <field name="unit_id"/>
                                        <field name="service_type"/>
                                        <field name="frequency"/>
                                        <field name="next_due_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Service Calls">
                                <field name="cafm_request_ids">
                                    <tree>
                                        <field name="ticket_no"/>
                                        <field name="name"/>
                                        <field name="cafm_unit_id"/>
                                        <field name="work_type"/>
                                        <field name="problem"/>
                                        <field name="request_date"/>
                                        <field name="stage_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_projects" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_cpabooks_cafm_projects_tree_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_project_project_cafm_tree"/>
            <field name="act_window_id" ref="action_cpabooks_cafm_projects"/>
        </record>

        <record id="action_cpabooks_cafm_projects_form_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_project_project_cafm_form"/>
            <field name="act_window_id" ref="action_cpabooks_cafm_projects"/>
        </record>

        <menuitem id="menu_cpabooks_cafm_projects"
                  name="Projects"
                  parent="menu_cpabooks_cafm_operations"
                  action="action_cpabooks_cafm_projects"
                  sequence="1"/>
    </data>
</odoo>
