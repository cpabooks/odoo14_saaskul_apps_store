<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cafm_stock_issue_tree" model="ir.ui.view">
        <field name="name">cpabooks.cafm.stock.issue.tree</field>
        <field name="model">cpabooks.cafm.stock.issue</field>
        <field name="arch" type="xml">
            <tree string="Stock Issue" class="o_cafm_tally_tree">
                <field name="name"/>
                <field name="issue_date"/>
                <field name="issue_type"/>
                <field name="call_no"/>
                <field name="partner_id"/>
                <field name="flat_villa"/>
                <field name="technician_id"/>
                <field name="warehouse"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_cafm_stock_issue_form" model="ir.ui.view">
        <field name="name">cpabooks.cafm.stock.issue.form</field>
        <field name="model">cpabooks.cafm.stock.issue</field>
        <field name="arch" type="xml">
            <form string="Stock Issue" class="o_cafm_tally_form">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="o_cafm_tally_header"><span>Stock Issue</span></div>
                    <div class="o_cafm_tally_title_block">Stock Issue</div>
                    <group col="4">
                        <field name="name"/>
                        <field name="issue_date"/>
                        <field name="issue_type"/>
                        <field name="call_id"/>
                        <field name="partner_id"/>
                        <field name="cafm_unit_id"/>
                        <field name="flat_villa"/>
                        <field name="technician_id"/>
                        <field name="warehouse"/>
                        <field name="remark"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_name"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="remark"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cafm_stock_issue_search" model="ir.ui.view">
        <field name="name">cpabooks.cafm.stock.issue.search</field>
        <field name="model">cpabooks.cafm.stock.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="call_no"/>
                <field name="partner_id"/>
                <field name="name"/>
                <filter name="amc" string="AMC Stock Issue" domain="[('issue_type','=','amc')]"/>
                <filter name="var" string="VAR Stock Issue" domain="[('issue_type','=','var')]"/>
                <filter name="transfer" string="Stock Transfer" domain="[('issue_type','=','transfer')]"/>
                <filter name="receipt" string="Receipt Note" domain="[('issue_type','=','receipt')]"/>
            </search>
        </field>
    </record>

    <record id="action_cafm_stock_issue_amc" model="ir.actions.act_window">
        <field name="name">AMC Stock Issue</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','=','amc')]</field>
        <field name="context">{'default_issue_type': 'amc'}</field>
    </record>
    <record id="action_cafm_stock_issue_var" model="ir.actions.act_window">
        <field name="name">VAR Stock Issue</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','=','var')]</field>
        <field name="context">{'default_issue_type': 'var'}</field>
    </record>
    <record id="action_cafm_stock_transfer" model="ir.actions.act_window">
        <field name="name">Stock Transfer</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','=','transfer')]</field>
        <field name="context">{'default_issue_type': 'transfer'}</field>
    </record>
    <record id="action_cafm_stock_receipt_report" model="ir.actions.act_window">
        <field name="name">Call-wise Stock Receipt Note Report</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','=','receipt')]</field>
        <field name="context">{'default_issue_type': 'receipt'}</field>
    </record>
    <record id="action_cafm_stock_issue_report" model="ir.actions.act_window">
        <field name="name">Call-wise Stock Issue Report</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','in',('amc','var'))]</field>
    </record>
    <record id="action_cafm_amc_stock_issue_report" model="ir.actions.act_window">
        <field name="name">AMC Call Stock Issue Report</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','=','amc')]</field>
    </record>
    <record id="action_cafm_var_stock_issue_report" model="ir.actions.act_window">
        <field name="name">VAR Call Stock Issue Report</field>
        <field name="res_model">cpabooks.cafm.stock.issue</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('issue_type','=','var')]</field>
    </record>
</odoo>
