<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_cpabooks_cafm_ppm_tree" model="ir.ui.view">
            <field name="name">cpabooks.cafm.ppm.tree</field>
            <field name="model">cpabooks.cafm.ppm</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="unit_id"/>
                    <field name="service_type"/>
                    <field name="frequency"/>
                    <field name="annual_visits"/>
                    <field name="next_due_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_cpabooks_cafm_ppm_form" model="ir.ui.view">
            <field name="name">cpabooks.cafm.ppm.form</field>
            <field name="model">cpabooks.cafm.ppm</field>
            <field name="arch" type="xml">
                <form string="PPM Activity">
                    <header>
                        <button name="action_open_project" type="object" string="Open Project" class="btn-secondary"/>
                        <button name="action_open_unit" type="object" string="Open Villa / Flat" class="btn-secondary" attrs="{'invisible': [('unit_id', '=', False)]}"/>
                        <button name="action_view_requests" type="object" string="Open Service Calls" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="unit_id" domain="[('project_id', '=', project_id)]"/>
                                <field name="service_type"/>
                                <field name="frequency"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="next_due_date"/>
                                <field name="end_date"/>
                                <field name="annual_visits" readonly="1"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="request_ids">
                                <tree>
                                    <field name="ticket_no"/>
                                    <field name="name"/>
                                    <field name="cafm_unit_id"/>
                                    <field name="request_date"/>
                                    <field name="stage_id"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cpabooks_cafm_ppm" model="ir.actions.act_window">
            <field name="name">PPM Schedule</field>
            <field name="res_model">cpabooks.cafm.ppm</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
