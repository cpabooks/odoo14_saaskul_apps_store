<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_lead_form_faff" model="ir.ui.view">
        <field name="name">crm.lead.form.faff</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_start_faff_process" type="object"
                        string="Start FAFF Process"
                        class="oe_highlight"
                        groups="cpabooks_faff.group_faff_user"/>
            </xpath>
            <field name="user_id" position="after">
                <field name="faff_job_id" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
