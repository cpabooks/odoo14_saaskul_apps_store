<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========== Pivot / Graph / Tree on FAFF Job ========== -->
    <record id="view_faff_job_pivot" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.pivot</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <pivot string="FAFF Jobs Analysis">
                <field name="job_type_id" type="row"/>
                <field name="stage" type="col"/>
                <field name="estimated_cost" type="measure"/>
                <field name="selling_amount" type="measure"/>
                <field name="expected_profit" type="measure"/>
                <field name="actual_total_cost" type="measure"/>
                <field name="invoice_amount" type="measure"/>
                <field name="paid_amount" type="measure"/>
                <field name="actual_profit" type="measure"/>
                <field name="cost_variance" type="measure"/>
                <field name="profit_variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_faff_job_graph" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.graph</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <graph string="FAFF Jobs" type="bar">
                <field name="stage"/>
                <field name="selling_amount" type="measure"/>
                <field name="actual_total_cost" type="measure"/>
                <field name="actual_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_faff_job_tree_profit" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.tree.profit</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <tree string="Profitability Summary" create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="job_type_id"/>
                <field name="salesperson_id"/>
                <field name="stage"/>
                <field name="estimated_cost" sum="Est. Cost"/>
                <field name="actual_total_cost" sum="Actual Cost"/>
                <field name="cost_variance" sum="Cost Var."/>
                <field name="selling_amount" sum="Selling"/>
                <field name="invoice_amount" sum="Invoice"/>
                <field name="revenue_variance" sum="Rev. Var."/>
                <field name="expected_profit" sum="Est. Profit"/>
                <field name="actual_profit" sum="Actual Profit"/>
                <field name="profit_variance" sum="Profit Var."/>
                <field name="margin_percent" avg="Est. %"/>
                <field name="actual_margin_percent" avg="Act. %"/>
                <field name="payment_status"/>
            </tree>
        </field>
    </record>

    <record id="action_faff_mis_jobs_analysis" model="ir.actions.act_window">
        <field name="name">Jobs Analysis</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_group_stage': 1}</field>
    </record>

    <record id="action_faff_mis_profit_summary" model="ir.actions.act_window">
        <field name="name">Profitability Summary</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="view_id" ref="view_faff_job_tree_profit"/>
        <field name="context">{'pivot_measures': ['estimated_cost','actual_total_cost','selling_amount','invoice_amount','actual_profit','profit_variance']}</field>
    </record>

    <record id="action_faff_mis_comparison_summary" model="ir.actions.act_window">
        <field name="name">Comparison Summary</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="view_id" ref="view_faff_job_tree_profit"/>
        <field name="context">{'pivot_column_groupby': ['stage'], 'pivot_row_groupby': ['job_type_id'], 'pivot_measures': ['estimated_cost','actual_total_cost','cost_variance','selling_amount','invoice_amount','expected_profit','actual_profit','profit_variance']}</field>
    </record>

    <!-- ========== BOQ / Profitability Detail ========== -->
    <record id="view_faff_estimate_line_tree_mis" model="ir.ui.view">
        <field name="name">cpabooks.faff.estimate.line.tree.mis</field>
        <field name="model">cpabooks.faff.estimate.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="job_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="product_uom_qty" sum="Qty"/>
                <field name="material_cost" sum="Material"/>
                <field name="labour_cost" sum="Labour"/>
                <field name="equipment_cost" sum="Equipment"/>
                <field name="subcontract_cost" sum="Subcontract"/>
                <field name="other_cost" sum="Other"/>
                <field name="total_cost" sum="Est. Cost"/>
                <field name="selling_price"/>
                <field name="total_selling_price" sum="Selling"/>
                <field name="margin_percent" avg="Margin %"/>
            </tree>
        </field>
    </record>

    <record id="view_faff_estimate_line_pivot" model="ir.ui.view">
        <field name="name">cpabooks.faff.estimate.line.pivot</field>
        <field name="model">cpabooks.faff.estimate.line</field>
        <field name="arch" type="xml">
            <pivot string="BOQ Profitability Detail">
                <field name="job_id" type="row"/>
                <field name="category" type="col"/>
                <field name="total_cost" type="measure"/>
                <field name="total_selling_price" type="measure"/>
                <field name="material_cost" type="measure"/>
                <field name="labour_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_faff_mis_profit_detail" model="ir.actions.act_window">
        <field name="name">Profitability Detail (BOQ)</field>
        <field name="res_model">cpabooks.faff.estimate.line</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="view_id" ref="view_faff_estimate_line_tree_mis"/>
    </record>

    <!-- ========== Comparison Detail (SQL view) ========== -->
    <record id="view_faff_mis_detail_tree" model="ir.ui.view">
        <field name="name">cpabooks.faff.mis.detail.tree</field>
        <field name="model">cpabooks.faff.mis.detail</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="job_id"/>
                <field name="partner_id"/>
                <field name="job_type_id"/>
                <field name="stage"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="qty_estimated" sum="Est. Qty"/>
                <field name="qty_required" sum="Req."/>
                <field name="qty_issued" sum="Issued"/>
                <field name="qty_purchased" sum="PO Qty"/>
                <field name="estimated_cost" sum="Est. Cost"/>
                <field name="actual_material_cost" sum="Actual Mat."/>
                <field name="cost_variance" sum="Cost Var."/>
                <field name="selling_amount" sum="Selling"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_faff_mis_detail_pivot" model="ir.ui.view">
        <field name="name">cpabooks.faff.mis.detail.pivot</field>
        <field name="model">cpabooks.faff.mis.detail</field>
        <field name="arch" type="xml">
            <pivot string="Comparison Detail">
                <field name="job_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="estimated_cost" type="measure"/>
                <field name="actual_material_cost" type="measure"/>
                <field name="cost_variance" type="measure"/>
                <field name="selling_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_faff_mis_detail_graph" model="ir.ui.view">
        <field name="name">cpabooks.faff.mis.detail.graph</field>
        <field name="model">cpabooks.faff.mis.detail</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="job_id"/>
                <field name="estimated_cost" type="measure"/>
                <field name="actual_material_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_faff_mis_detail_search" model="ir.ui.view">
        <field name="name">cpabooks.faff.mis.detail.search</field>
        <field name="model">cpabooks.faff.mis.detail</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <group expand="0" string="Group By">
                    <filter name="group_job" string="Job" context="{'group_by': 'job_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Job Type" context="{'group_by': 'job_type_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_faff_mis_comparison_detail" model="ir.actions.act_window">
        <field name="name">Comparison Detail</field>
        <field name="res_model">cpabooks.faff.mis.detail</field>
        <field name="view_mode">tree,pivot,graph</field>
    </record>

    <!-- ========== Daily Activity ========== -->
    <record id="view_faff_stage_history_tree_mis" model="ir.ui.view">
        <field name="name">cpabooks.faff.stage.history.tree.mis</field>
        <field name="model">cpabooks.faff.stage.history</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="report_date"/>
                <field name="change_date"/>
                <field name="job_id"/>
                <field name="partner_id"/>
                <field name="job_type_id"/>
                <field name="salesperson_id"/>
                <field name="from_stage"/>
                <field name="to_stage"/>
                <field name="user_id"/>
                <field name="is_override"/>
                <field name="remarks"/>
            </tree>
        </field>
    </record>

    <record id="view_faff_stage_history_pivot" model="ir.ui.view">
        <field name="name">cpabooks.faff.stage.history.pivot</field>
        <field name="model">cpabooks.faff.stage.history</field>
        <field name="arch" type="xml">
            <pivot string="Daily Job Activity">
                <field name="report_date" type="row" interval="day"/>
                <field name="to_stage" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_faff_stage_history_search_mis" model="ir.ui.view">
        <field name="name">cpabooks.faff.stage.history.search.mis</field>
        <field name="model">cpabooks.faff.stage.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="to_stage"/>
                <filter name="today" string="Today" domain="[('report_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This Week" domain="[('report_date','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="overrides" string="Manager Overrides" domain="[('is_override','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_date" string="Date" context="{'group_by': 'report_date'}"/>
                    <filter name="group_job" string="Job" context="{'group_by': 'job_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_to" string="To Stage" context="{'group_by': 'to_stage'}"/>
                    <filter name="group_type" string="Job Type" context="{'group_by': 'job_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_faff_mis_daily" model="ir.actions.act_window">
        <field name="name">Daily Job Activity</field>
        <field name="res_model">cpabooks.faff.stage.history</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="view_id" ref="view_faff_stage_history_tree_mis"/>
        <field name="search_view_id" ref="view_faff_stage_history_search_mis"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- ========== Print wizard ========== -->
    <record id="view_faff_mis_wizard_form" model="ir.ui.view">
        <field name="name">cpabooks.faff.mis.wizard.form</field>
        <field name="model">cpabooks.faff.mis.wizard</field>
        <field name="arch" type="xml">
            <form string="Print FAFF MIS">
                <group>
                    <group>
                        <field name="report_kind"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                        <field name="job_type_id"/>
                        <field name="salesperson_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_faff_mis_print_wizard" model="ir.actions.act_window">
        <field name="name">Print MIS Report</field>
        <field name="res_model">cpabooks.faff.mis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ========== Financial: FAFF-tagged standard docs ========== -->
    <record id="action_faff_mis_invoices" model="ir.actions.act_window">
        <field name="name">FAFF Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('faff_job_id','!=',False),('move_type','=','out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_faff_mis_receivable" model="ir.actions.act_window">
        <field name="name">Outstanding Receivable</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('faff_job_id','!=',False),('move_type','=','out_invoice'),('state','=','posted'),('amount_residual','&gt;',0)]</field>
    </record>

    <record id="action_faff_mis_purchase_orders" model="ir.actions.act_window">
        <field name="name">FAFF Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('faff_job_id','!=',False)]</field>
    </record>

    <record id="action_faff_mis_pickings" model="ir.actions.act_window">
        <field name="name">Material Issues / Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('faff_job_id','!=',False)]</field>
    </record>

    <record id="action_faff_mis_sale_orders" model="ir.actions.act_window">
        <field name="name">FAFF Quotations / Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('faff_job_id','!=',False)]</field>
    </record>

    <!-- ========== Project Dashboard bridges (optional module) ========== -->
    <record id="action_faff_bridge_project_dashboard" model="ir.actions.server">
        <field name="name">Project Dashboard</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_dashboard').action_open()</field>
    </record>
    <record id="action_faff_bridge_financial_dashboard" model="ir.actions.server">
        <field name="name">Financial Dashboard</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_financial_dashboard').action_open()</field>
    </record>
    <record id="action_faff_bridge_pl" model="ir.actions.server">
        <field name="name">Multi-level Profit &amp; Loss</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_multilevel_pl_dashboard').action_open()</field>
    </record>
    <record id="action_faff_bridge_bs" model="ir.actions.server">
        <field name="name">Balance Sheet</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_balance_sheet_dashboard').action_open()</field>
    </record>
    <record id="action_faff_bridge_ap_ar" model="ir.actions.server">
        <field name="name">AP &amp; AR Control</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_ap_ar_control_dashboard').action_open()</field>
    </record>
    <record id="action_faff_bridge_result" model="ir.actions.server">
        <field name="name">Project Result Control</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_result_control_dashboard').action_open()</field>
    </record>
    <record id="action_faff_bridge_activities" model="ir.actions.server">
        <field name="name">Activities Control</field>
        <field name="model_id" ref="model_cpabooks_faff_dashboard_bridge"/>
        <field name="state">code</field>
        <field name="code">action = env['cpabooks.faff.dashboard.bridge'].with_context(faff_bridge_xmlid='project_dashboard_odoo.project_action_activities_control_dashboard').action_open()</field>
    </record>
</odoo>
