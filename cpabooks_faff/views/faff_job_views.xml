<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_faff_job_tree" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.tree</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="job_type_id"/>
                <field name="salesperson_id"/>
                <field name="stage"/>
                <field name="progress" widget="progressbar"/>
                <field name="estimated_cost"/>
                <field name="selling_amount"/>
                <field name="expected_profit"/>
                <field name="invoice_amount"/>
                <field name="payment_status"/>
            </tree>
        </field>
    </record>

    <record id="view_faff_job_form" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.form</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <form string="FAFF Job">
                <header>
                    <button name="action_continue_wizard" type="object" string="Continue FAFF Process"
                            class="oe_highlight" groups="cpabooks_faff.group_faff_user"/>
                    <button name="action_set_cancelled" type="object" string="Cancel"
                            groups="cpabooks_faff.group_faff_manager"
                            confirm="Cancel this FAFF job?"/>
                    <field name="stage" widget="statusbar"
                             statusbar_visible="crm,inspection,estimation,quotation,confirmed,project,material,execution,testing,completion,invoice,payment,done"/>
                </header>
                <sheet>
                    <!-- Smart buttons — original instruction set -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_crm" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="crm_count" widget="statinfo" string="CRM"/>
                        </button>
                        <button name="action_open_visits" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="visit_count" widget="statinfo" string="Inspection"/>
                        </button>
                        <button name="action_open_estimates" type="object" class="oe_stat_button" icon="fa-calculator">
                            <field name="estimate_count" widget="statinfo" string="Estimation"/>
                        </button>
                        <button name="action_open_sale" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="quotation_count" widget="statinfo" string="Quotation"/>
                        </button>
                        <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-folder-open-o">
                            <field name="project_count" widget="statinfo" string="Project"/>
                        </button>
                        <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                        <button name="action_open_purchases" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_count" widget="statinfo" string="Purchase"/>
                        </button>
                        <button name="action_open_pickings" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="picking_count" widget="statinfo" string="Material Issues"/>
                        </button>
                        <button name="action_open_deliveries" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="delivery_count" widget="statinfo" string="Delivery"/>
                        </button>
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                        <button name="action_open_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payment"/>
                        </button>
                        <button name="action_open_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="FAFF Number"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_id"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="site_name"/>
                            <field name="site_address"/>
                            <field name="job_type_id"/>
                        </group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="lead_source_id"/>
                            <field name="status"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="payment_status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- 1. Details -->
                        <page string="Details" name="details">
                            <group>
                                <group string="CRM / Customer">
                                    <field name="crm_lead_id"/>
                                    <field name="description"/>
                                    <field name="planned_start_date"/>
                                    <field name="expected_end_date"/>
                                    <field name="actual_start_date"/>
                                    <field name="actual_end_date"/>
                                    <field name="wizard_step"/>
                                </group>
                                <group string="Financial summary">
                                    <field name="estimated_cost"/>
                                    <field name="selling_amount"/>
                                    <field name="expected_profit"/>
                                    <field name="margin_percent"/>
                                    <field name="actual_total_cost"/>
                                    <field name="invoice_amount"/>
                                    <field name="paid_amount"/>
                                    <field name="balance_amount"/>
                                    <field name="actual_profit"/>
                                    <field name="actual_margin_percent"/>
                                </group>
                            </group>
                            <group string="Cost breakdown">
                                <group string="Estimated">
                                    <field name="estimated_material_cost"/>
                                    <field name="estimated_labour_cost"/>
                                    <field name="estimated_other_cost"/>
                                </group>
                                <group string="Actual">
                                    <field name="actual_material_cost"/>
                                    <field name="actual_purchase_cost"/>
                                    <field name="actual_labour_cost"/>
                                    <field name="actual_other_cost"/>
                                </group>
                            </group>
                        </page>

                        <!-- 2. Inspection -->
                        <page string="Inspection" name="inspection">
                            <field name="visit_ids" context="{'default_job_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="inspection_date"/>
                                    <field name="site_engineer_id"/>
                                    <field name="site_contact"/>
                                    <field name="existing_system"/>
                                    <field name="panel_type"/>
                                    <field name="floor_count"/>
                                    <field name="device_count"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 3. Estimation -->
                        <page string="Estimation" name="estimation">
                            <field name="estimate_ids" context="{'default_job_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="total_material_cost"/>
                                    <field name="total_labour_cost"/>
                                    <field name="total_cost"/>
                                    <field name="selling_amount"/>
                                    <field name="expected_profit"/>
                                    <field name="margin_percent"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 4. Quotation -->
                        <page string="Quotation" name="quotation">
                            <group>
                                <field name="sale_order_id"/>
                            </group>
                            <div class="alert alert-info" role="status"
                                 attrs="{'invisible': [('sale_order_id', '!=', False)]}">
                                No quotation yet — use <strong>Continue FAFF Process</strong> → Create Quotation / Confirm.
                            </div>
                        </page>

                        <!-- 5. Project / Tasks -->
                        <page string="Project / Tasks" name="project_tasks">
                            <group>
                                <field name="project_id"/>
                            </group>
                            <separator string="Tasks"/>
                            <field name="task_ids" context="{'default_faff_job_id': active_id, 'default_project_id': project_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="project_id" optional="hide"/>
                                    <field name="user_id"/>
                                    <field name="faff_engineer_id"/>
                                    <field name="date_deadline"/>
                                    <field name="stage_id"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="faff_hours"/>
                                    <field name="faff_remarks"/>
                                    <field name="company_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 6. Material -->
                        <page string="Material" name="material">
                            <field name="material_plan_ids" context="{'default_job_id': active_id}">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_id"/>
                                    <field name="qty_required"/>
                                    <field name="qty_available"/>
                                    <field name="qty_reserved"/>
                                    <field name="issue_qty"/>
                                    <field name="purchase_qty"/>
                                    <field name="state"/>
                                    <button name="action_suggest_split" type="object" string="Split" icon="fa-magic"/>
                                    <button name="action_issue_from_store" type="object" string="Issue" icon="fa-truck"/>
                                    <button name="action_create_purchase_rfq" type="object" string="RFQ" icon="fa-shopping-cart"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 7. Purchase -->
                        <page string="Purchase" name="purchase">
                            <field name="purchase_order_ids" context="{'default_faff_job_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 8. Execution -->
                        <page string="Execution" name="execution">
                            <group>
                                <field name="progress" widget="progressbar"/>
                                <field name="actual_start_date"/>
                                <field name="actual_end_date"/>
                            </group>
                            <separator string="Site tasks / progress"/>
                            <field name="task_ids" context="{'default_faff_job_id': active_id, 'default_project_id': project_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="faff_engineer_id"/>
                                    <field name="date_deadline"/>
                                    <field name="stage_id"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="faff_hours"/>
                                    <field name="faff_remarks"/>
                                    <field name="faff_photo_ids" widget="many2many_binary"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="project_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 9. Testing -->
                        <page string="Testing" name="testing">
                            <field name="testing_ids" context="{'default_job_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="testing_date"/>
                                    <field name="tested_by_id"/>
                                    <field name="system_status"/>
                                    <field name="panel_tested"/>
                                    <field name="devices_tested"/>
                                    <field name="pump_tested"/>
                                    <field name="alarm_tested"/>
                                    <field name="rectification_required"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 10. Delivery -->
                        <page string="Delivery" name="delivery">
                            <separator string="Handover / Completion notes"/>
                            <field name="completion_ids" context="{'default_job_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="completion_date"/>
                                    <field name="customer_name"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                            <separator string="Customer deliveries (stock)"/>
                            <field name="picking_ids" domain="[('picking_type_code', '=', 'outgoing')]"
                                      context="{'default_faff_job_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="picking_type_id"/>
                                    <field name="origin"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 11. Invoice -->
                        <page string="Invoice" name="invoice">
                            <field name="invoice_ids" domain="[('move_type', '=', 'out_invoice')]"
                                      context="{'default_move_type': 'out_invoice', 'default_faff_job_id': active_id, 'default_partner_id': partner_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total"/>
                                    <field name="amount_residual"/>
                                    <field name="payment_state"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>

                        <!-- 12. Payment -->
                        <page string="Payment" name="payment">
                            <group>
                                <group>
                                    <field name="invoice_amount"/>
                                    <field name="paid_amount"/>
                                    <field name="balance_amount"/>
                                    <field name="payment_status"/>
                                </group>
                                <group>
                                    <button name="action_open_payments" type="object"
                                            string="Open Payments" class="btn-primary"/>
                                    <button name="action_open_invoices" type="object"
                                            string="Open Invoices" class="btn-secondary"/>
                                </group>
                            </group>
                        </page>

                        <!-- 13. Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes…"/>
                            <separator string="Remarks"/>
                            <field name="remarks" placeholder="Job remarks…"/>
                        </page>

                        <!-- 14. History -->
                        <page string="History" name="history">
                            <field name="stage_history_ids" readonly="1">
                                <tree>
                                    <field name="change_date"/>
                                    <field name="from_stage"/>
                                    <field name="to_stage"/>
                                    <field name="user_id"/>
                                    <field name="is_override"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                            <group>
                                <field name="override_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_faff_job_search" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.search</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="job_type_id"/>
                <filter name="my_jobs" string="My Jobs" domain="[('salesperson_id', '=', uid)]"/>
                <filter name="new" string="New" domain="[('stage', '=', 'crm')]"/>
                <filter name="estimation_pending" string="Estimation Pending" domain="[('stage', 'in', ('crm','inspection','estimation'))]"/>
                <filter name="quotation_pending" string="Quotation Pending" domain="[('stage', '=', 'quotation')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('stage', '=', 'confirmed')]"/>
                <filter name="material_pending" string="Material Pending" domain="[('stage', '=', 'material')]"/>
                <filter name="in_progress" string="In Progress" domain="[('status', '=', 'in_progress')]"/>
                <filter name="testing_pending" string="Testing Pending" domain="[('stage', '=', 'testing')]"/>
                <filter name="completion_pending" string="Completion Pending" domain="[('stage', '=', 'completion')]"/>
                <filter name="invoice_pending" string="Invoice Pending" domain="[('stage', '=', 'invoice')]"/>
                <filter name="payment_pending" string="Payment Pending" domain="[('stage', '=', 'payment'), ('payment_status', '!=', 'paid')]"/>
                <filter name="completed" string="Completed" domain="[('stage', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('stage', '=', 'cancel')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_job_type" string="Job Type" context="{'group_by': 'job_type_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_faff_job_kanban" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.kanban</field>
        <field name="model">cpabooks.faff.job</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="progress"/>
                <field name="stage"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div><field name="site_name"/></div>
                            <div><field name="progress" widget="progressbar"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_faff_dashboard_client" model="ir.actions.client">
        <field name="name">FAFF Dashboard</field>
        <field name="tag">faff_dashboard</field>
    </record>

    <record id="action_faff_jobs_analysis" model="ir.actions.act_window">
        <field name="name">Jobs Analysis</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
    </record>

    <record id="action_faff_job" model="ir.actions.act_window">
        <field name="name">FAFF Jobs</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a FAFF Job or open the FAFF Job Wizard.</p>
        </field>
    </record>

    <record id="action_faff_job_my" model="ir.actions.act_window">
        <field name="name">My Jobs</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_jobs': 1}</field>
    </record>

    <record id="action_faff_crm" model="ir.actions.act_window">
        <field name="name">1. CRM / Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
    </record>
    <record id="action_faff_quotations" model="ir.actions.act_window">
        <field name="name">4. Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('faff_job_id', '!=', False), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{'default_faff_job_id': False}</field>
    </record>
    <record id="action_faff_confirmed_orders" model="ir.actions.act_window">
        <field name="name">5. Confirmed Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('faff_job_id', '!=', False), ('state', 'in', ('sale', 'done'))]</field>
    </record>
    <record id="action_faff_projects" model="ir.actions.act_window">
        <field name="name">6. Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('faff_job_id', '!=', False)]</field>
    </record>
    <record id="action_faff_tasks" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('faff_job_id', '!=', False)]</field>
    </record>
    <record id="action_faff_purchases" model="ir.actions.act_window">
        <field name="name">Purchase</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('faff_job_id', '!=', False)]</field>
        <field name="context">{'default_faff_job_id': False}</field>
    </record>
    <record id="action_faff_execution_jobs" model="ir.actions.act_window">
        <field name="name">8. Execution</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('stage', '=', 'execution')]</field>
    </record>
    <record id="action_faff_invoices" model="ir.actions.act_window">
        <field name="name">11. Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('faff_job_id', '!=', False), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
    <record id="action_faff_payments" model="ir.actions.act_window">
        <field name="name">12. Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer'}</field>
    </record>
    <record id="action_faff_job_closed" model="ir.actions.act_window">
        <field name="name">13. Job Closing</field>
        <field name="res_model">cpabooks.faff.job</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('stage', '=', 'done')]</field>
    </record>
</odoo>
