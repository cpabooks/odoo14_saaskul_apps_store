<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_faff_job_wizard_form" model="ir.ui.view">
        <field name="name">cpabooks.faff.job.wizard.form</field>
        <field name="model">cpabooks.faff.job.wizard</field>
        <field name="arch" type="xml">
            <form string="FAFF Process Wizard" class="o_faff_process_wizard" create="false" delete="false">
                <sheet>
                    <div class="o_faff_wiz_layout">
                        <div class="o_faff_wiz_left">
                            <field name="progress_html" nolabel="1" readonly="1" widget="faff_wizard_progress_html"/>
                        </div>
                        <div class="o_faff_wiz_right">
                            <div class="oe_title">
                                <h1><field name="progress_label" readonly="1"/></h1>
                                <h2><field name="step_title" readonly="1"/></h2>
                                <h3 attrs="{'invisible': [('job_id', '=', False)]}">
                                    <span>Job: </span>
                                    <field name="job_id" readonly="1" class="oe_inline" options="{'no_open': False}"/>
                                </h3>
                            </div>

                            <p class="o_faff_wiz_hint text-muted">
                                <field name="step_hint" readonly="1" nolabel="1"/>
                            </p>

                            <div class="alert alert-success" role="status"
                                 attrs="{'invisible': [('is_finished', '=', False)]}">
                                <strong>Finished.</strong> This FAFF job is complete from CRM to Payment.
                            </div>

                            <field name="step_key" invisible="1"/>
                            <field name="step_index" invisible="1"/>
                            <field name="total_steps" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="project_id" invisible="1"/>
                            <field name="is_first" invisible="1"/>
                            <field name="is_last" invisible="1"/>
                            <field name="is_finished" invisible="1"/>
                            <field name="override_reason" invisible="1"/>

                            <!-- STEP 1 CRM -->
                            <group string="Customer &amp; site" attrs="{'invisible': [('step_key', '!=', 'crm')]}">
                                <group>
                                    <field name="create_new_opportunity"/>
                                    <field name="crm_lead_id" attrs="{'invisible': [('create_new_opportunity', '=', True)]}"/>
                                    <field name="opportunity_name"/>
                                    <field name="partner_id" required="1"/>
                                    <field name="contact_id"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="site_name"/>
                                    <field name="site_address"/>
                                    <field name="salesperson_id"/>
                                    <field name="lead_source_id"/>
                                    <field name="job_type_id"/>
                                    <field name="planned_start_date"/>
                                    <field name="expected_end_date"/>
                                </group>
                                <field name="description" colspan="2"/>
                            </group>

                            <!-- STEP 2 Inspection -->
                            <group string="Site inspection" attrs="{'invisible': [('step_key', '!=', 'inspection')]}">
                                <group>
                                    <field name="visit_id" readonly="1"/>
                                    <field name="inspection_date"/>
                                    <field name="site_engineer_id"/>
                                    <field name="site_contact"/>
                                    <field name="existing_system"/>
                                    <field name="existing_brand"/>
                                    <field name="panel_type"/>
                                    <field name="floor_count"/>
                                    <field name="device_count"/>
                                </group>
                                <group>
                                    <field name="problem_requirement"/>
                                    <field name="observation"/>
                                    <field name="technical_recommendation"/>
                                    <field name="scope_summary"/>
                                    <field name="inspection_remarks"/>
                                    <field name="visit_attachment_ids" widget="many2many_binary"/>
                                </group>
                            </group>

                            <!-- STEP 3 Estimation — tree outside inner group so it gets full width -->
                            <div class="o_faff_wiz_wide" attrs="{'invisible': [('step_key', '!=', 'estimation')]}">
                                <group>
                                    <group>
                                        <field name="estimate_id" readonly="1"/>
                                        <button name="action_save_estimation" type="object" string="Save Estimation" class="btn-secondary"/>
                                        <button name="action_approve_estimation" type="object" string="Approve Estimation" class="btn-primary"/>
                                    </group>
                                    <group string="Totals">
                                        <field name="estimated_cost"/>
                                        <field name="selling_amount"/>
                                        <field name="expected_profit"/>
                                        <field name="margin_percent"/>
                                    </group>
                                </group>
                                <field name="estimate_line_ids" nolabel="1" class="o_faff_wiz_list">
                                    <tree editable="bottom">
                                        <field name="product_id" string="Product"/>
                                        <field name="name" string="Description"/>
                                        <field name="category" string="Cat." optional="hide"/>
                                        <field name="product_uom_qty" string="Qty"/>
                                        <field name="product_uom_id" string="UoM"/>
                                        <field name="material_cost" string="Mat."/>
                                        <field name="labour_cost" string="Labour"/>
                                        <field name="equipment_cost" string="Equip." optional="hide"/>
                                        <field name="subcontract_cost" string="Subcon." optional="hide"/>
                                        <field name="other_cost" string="Other" optional="hide"/>
                                        <field name="total_cost" string="Est. Cost"/>
                                        <field name="margin_percent" string="M%"/>
                                        <field name="selling_price" string="Sell / Unit"/>
                                        <field name="tax_ids" widget="many2many_tags" string="Tax" optional="hide"/>
                                        <field name="total_selling_price" string="Selling"/>
                                    </tree>
                                </field>
                            </div>

                            <!-- STEP 4 Quotation -->
                            <group string="4. Quotation" attrs="{'invisible': [('step_key', '!=', 'quotation')]}">
                                <group>
                                    <button name="action_create_quotation" type="object" string="Create Quotation" class="btn-primary"/>
                                    <button name="action_open_quotation" type="object" string="Open Quotation"/>
                                    <field name="sale_order_id" readonly="1"/>
                                    <field name="quotation_name"/>
                                    <field name="quotation_amount"/>
                                    <field name="quotation_state"/>
                                    <field name="validity_date"/>
                                </group>
                            </group>

                            <!-- STEP 5 Confirm Quotation -->
                            <group string="5. Confirm Quotation" attrs="{'invisible': [('step_key', '!=', 'confirm')]}">
                                <group>
                                    <field name="sale_order_id" readonly="1"/>
                                    <field name="quotation_name"/>
                                    <field name="quotation_amount"/>
                                    <field name="quotation_state"/>
                                    <button name="action_confirm_quotation" type="object" string="Confirm Quotation" class="btn-primary"/>
                                    <button name="action_open_quotation" type="object" string="Open Quotation"/>
                                </group>
                            </group>

                            <!-- STEP 6 Project -->
                            <group string="Project + tasks" attrs="{'invisible': [('step_key', '!=', 'project')]}">
                                <field name="default_task_ids" widget="many2many_tags"/>
                                <button name="action_create_project_tasks" type="object" string="Create Project + Tasks" class="btn-primary"/>
                                <field name="project_id" readonly="1"/>
                            </group>

                            <!-- STEP 7 Material -->
                            <div class="o_faff_wiz_wide" attrs="{'invisible': [('step_key', '!=', 'material')]}">
                                <separator string="Materials"/>
                                <field name="material_plan_ids" nolabel="1" class="o_faff_wiz_list">
                                    <tree editable="bottom">
                                        <field name="product_id" string="Product"/>
                                        <field name="qty_required" string="Required"/>
                                        <field name="qty_available" string="Available"/>
                                        <field name="qty_reserved" string="Reserved" optional="hide"/>
                                        <field name="issue_qty" string="Issue"/>
                                        <field name="purchase_qty" string="Purchase"/>
                                        <field name="state"/>
                                        <button name="action_suggest_split" type="object" string="Split"/>
                                        <button name="action_issue_from_store" type="object" string="Issue"/>
                                        <button name="action_create_purchase_rfq" type="object" string="RFQ"/>
                                    </tree>
                                </field>
                            </div>

                            <!-- STEP 8 Execution -->
                            <div class="o_faff_wiz_wide" attrs="{'invisible': [('step_key', '!=', 'execution')]}">
                                <group>
                                    <field name="job_progress" widget="progressbar"/>
                                </group>
                                <field name="task_ids" nolabel="1" class="o_faff_wiz_list">
                                    <tree editable="bottom">
                                        <field name="name" string="Task"/>
                                        <field name="user_id" string="Assigned"/>
                                        <field name="faff_engineer_id" string="Engineer"/>
                                        <field name="date_deadline" string="Deadline"/>
                                        <field name="progress" widget="progressbar"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="project_id" invisible="1"/>
                                        <field name="stage_id" string="Stage"/>
                                        <field name="faff_hours" string="Hours"/>
                                        <field name="faff_remarks" string="Remarks"/>
                                    </tree>
                                </field>
                            </div>

                            <!-- STEP 8 Testing -->
                            <group string="Testing &amp; commissioning" attrs="{'invisible': [('step_key', '!=', 'testing')]}">
                                <group>
                                    <field name="testing_id" readonly="1"/>
                                    <field name="testing_date"/>
                                    <field name="tested_by_id"/>
                                    <field name="system_status"/>
                                    <field name="panel_tested"/>
                                    <field name="devices_tested"/>
                                    <field name="pump_tested"/>
                                    <field name="alarm_tested"/>
                                    <field name="cause_effect_tested"/>
                                    <field name="emergency_light_tested"/>
                                </group>
                                <group>
                                    <field name="testing_remarks"/>
                                    <field name="defects_found"/>
                                    <field name="rectification_required"/>
                                    <button name="action_create_rectification_task" type="object" string="Create Rectification Task"/>
                                </group>
                            </group>

                            <!-- STEP 9 Completion -->
                            <group string="Handover" attrs="{'invisible': [('step_key', '!=', 'completion')]}">
                                <group>
                                    <field name="completion_id" readonly="1"/>
                                    <field name="completion_date"/>
                                    <field name="work_completed"/>
                                    <field name="material_delivered"/>
                                    <field name="testing_result"/>
                                    <field name="outstanding_items"/>
                                    <field name="warranty"/>
                                    <field name="completion_remarks"/>
                                </group>
                                <group string="Customer sign-off">
                                    <field name="customer_name"/>
                                    <field name="customer_designation"/>
                                    <field name="customer_signature" widget="signature"/>
                                    <field name="sign_date"/>
                                    <button name="action_confirm_completion" type="object" string="Confirm Completion" class="btn-primary"/>
                                    <button name="action_print_completion" type="object" string="Print Handover Note"/>
                                </group>
                            </group>

                            <!-- STEP 10 Invoice -->
                            <group string="Invoice" attrs="{'invisible': [('step_key', '!=', 'invoice')]}">
                                <group>
                                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary"/>
                                    <button name="action_open_invoice" type="object" string="Open Invoice"/>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="invoice_name"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_untaxed"/>
                                    <field name="invoice_tax"/>
                                    <field name="invoice_total"/>
                                    <field name="invoice_residual"/>
                                    <field name="invoice_payment_state"/>
                                </group>
                            </group>

                            <!-- STEP 12 Payment -->
                            <group string="12. Payment" attrs="{'invisible': [('step_key', '!=', 'payment')]}">
                                <group>
                                    <field name="payment_status"/>
                                    <field name="invoice_total"/>
                                    <field name="paid_amount"/>
                                    <field name="balance_amount"/>
                                    <button name="action_register_payment" type="object" string="Register Payment" class="btn-primary"/>
                                </group>
                            </group>

                            <!-- STEP 13 Job Closing -->
                            <group string="13. Job Closing" attrs="{'invisible': [('step_key', '!=', 'closing')]}">
                                <group>
                                    <field name="job_id" readonly="1"/>
                                    <field name="payment_status"/>
                                    <field name="paid_amount"/>
                                    <field name="balance_amount"/>
                                    <field name="job_progress" widget="progressbar"/>
                                </group>
                                <div class="alert alert-info" role="status">
                                    All documents are linked on this FAFF Job. Click <strong>Finished</strong> to close.
                                </div>
                            </group>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_previous" type="object" string="Previous"
                            class="btn-secondary"
                            attrs="{'invisible': [('is_first', '=', True)]}"/>
                    <button name="action_save" type="object" string="Save" class="btn-secondary"/>
                    <button name="action_next" type="object" string="Next"
                            class="btn-primary"
                            attrs="{'invisible': [('is_last', '=', True)]}"/>
                    <button name="action_finish" type="object" string="Finished"
                            class="btn-primary"
                            attrs="{'invisible': [('is_last', '=', False)]}"/>
                    <button name="action_save_close" type="object" string="Save &amp; Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_faff_job_wizard" model="ir.actions.server">
        <field name="name">New FAFF Job</field>
        <field name="model_id" ref="model_cpabooks_faff_job_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_new_wizard()</field>
    </record>
</odoo>
