<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_faff_visit_tree" model="ir.ui.view">
        <field name="name">cpabooks.faff.visit.tree</field>
        <field name="model">cpabooks.faff.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="job_id"/>
                <field name="inspection_date"/>
                <field name="site_engineer_id"/>
            </tree>
        </field>
    </record>
    <record id="view_faff_visit_form" model="ir.ui.view">
        <field name="name">cpabooks.faff.visit.form</field>
        <field name="model">cpabooks.faff.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="job_id"/>
                        <field name="inspection_date"/>
                        <field name="site_engineer_id"/>
                        <field name="site_contact"/>
                        <field name="existing_system"/>
                        <field name="existing_brand"/>
                        <field name="panel_type"/>
                        <field name="floor_count"/>
                        <field name="device_count"/>
                    </group>
                    <group>
                        <field name="problem_requirement"/>
                        <field name="observation"/>
                        <field name="technical_recommendation"/>
                        <field name="scope_summary"/>
                        <field name="inspection_remarks"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="observation"/>
                            <field name="recommendation"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_faff_visit" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">cpabooks.faff.visit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
