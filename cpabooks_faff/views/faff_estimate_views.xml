<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_faff_estimate_tree" model="ir.ui.view">
        <field name="name">cpabooks.faff.estimate.tree</field>
        <field name="model">cpabooks.faff.estimate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="job_id"/>
                <field name="state"/>
                <field name="total_cost"/>
                <field name="selling_amount"/>
                <field name="expected_profit"/>
                <field name="margin_percent"/>
            </tree>
        </field>
    </record>
    <record id="view_faff_estimate_form" model="ir.ui.view">
        <field name="name">cpabooks.faff.estimate.form</field>
        <field name="model">cpabooks.faff.estimate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_save_estimation" type="object" string="Save Estimation" states="draft"/>
                    <button name="action_approve_estimation" type="object" string="Approve Estimation"
                            class="oe_highlight" states="draft,saved"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="job_id"/>
                        <field name="date"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Totals">
                        <field name="total_material_cost"/>
                        <field name="total_labour_cost"/>
                        <field name="total_other_cost"/>
                        <field name="total_cost"/>
                        <field name="selling_amount"/>
                        <field name="expected_profit"/>
                        <field name="margin_percent"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom_id"/>
                            <field name="material_cost"/>
                            <field name="labour_cost"/>
                            <field name="equipment_cost"/>
                            <field name="subcontract_cost"/>
                            <field name="other_cost"/>
                            <field name="total_cost"/>
                            <field name="margin_percent"/>
                            <field name="selling_price"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="total_selling_price"/>
                        </tree>
                    </field>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_faff_estimate" model="ir.actions.act_window">
        <field name="name">Estimations</field>
        <field name="res_model">cpabooks.faff.estimate</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
