<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_cpabooks_faff" model="ir.module.category">
            <field name="name">FAFF</field>
            <field name="sequence">22</field>
        </record>

        <record id="group_faff_user" model="res.groups">
            <field name="name">FAFF User</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_faff_sales" model="res.groups">
            <field name="name">FAFF Sales</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('group_faff_user'))]"/>
        </record>

        <record id="group_faff_engineer" model="res.groups">
            <field name="name">FAFF Engineer</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('group_faff_user'))]"/>
        </record>

        <record id="group_faff_store" model="res.groups">
            <field name="name">FAFF Store</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('group_faff_user'))]"/>
        </record>

        <record id="group_faff_purchase" model="res.groups">
            <field name="name">FAFF Purchase</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('group_faff_user'))]"/>
        </record>

        <record id="group_faff_accounts" model="res.groups">
            <field name="name">FAFF Accounts</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('group_faff_user'))]"/>
        </record>

        <record id="group_faff_manager" model="res.groups">
            <field name="name">FAFF Manager</field>
            <field name="category_id" ref="module_category_cpabooks_faff"/>
            <field name="implied_ids" eval="[(4, ref('group_faff_sales')), (4, ref('group_faff_engineer')), (4, ref('group_faff_store')), (4, ref('group_faff_purchase')), (4, ref('group_faff_accounts'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
