<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="FaffProcessFlow">
        <div class="o_faff_flow_root">
            <div class="o_faff_flow_header">
                <div>
                    <div class="o_faff_flow_kicker">Fire Alarm &amp; Fire Fighting Company</div>
                    <h1>FAFF Process Flow</h1>
                    <p class="o_faff_flow_sub">
                        One job → one wizard → start to finish. Click a step to open that screen.
                    </p>
                </div>
                <div class="o_faff_flow_badges">
                    <div class="o_faff_flow_badge">New Module: <b>cpabooks_faff</b></div>
                    <div class="o_faff_flow_badge">Menu Name: <b>FAFF</b></div>
                    <a href="#" class="o_faff_flow_start btn btn-primary">
                        <i class="fa fa-play"/> Start New FAFF Job
                    </a>
                </div>
            </div>
            <div class="o_faff_flow_board"/>
            <p class="o_faff_flow_hint text-muted">
                Job types (example): Fire Alarm System, Fire Fighting System, Fire Alarm + Fire Fighting, AMC / Maintenance.
            </p>
        </div>
    </t>
</templates>
