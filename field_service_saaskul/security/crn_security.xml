<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_crn" model="ir.module.category">
            <field name="name">Complaint Registration</field>
            <field name="description">Access to Complaint Registration Numbers (CRNs).</field>
            <field name="sequence">57</field>
        </record>

        <record id="group_crn_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_crn"/>
            <field name="implied_ids" eval="[
                (4, ref('project.group_project_user')),
                (4, ref('hr_timesheet.group_hr_timesheet_user')),
            ]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_crn_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_crn"/>
            <field name="implied_ids" eval="[
                (4, ref('group_crn_user')),
                (4, ref('project.group_project_manager')),
            ]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
