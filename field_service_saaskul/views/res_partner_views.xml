<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_fsm_customer_invoice_type" model="ir.ui.view">
        <field name="name">res.partner.form.fsm.customer.invoice.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="customer_invoice_type_id"
                       domain="[('name', 'in', ['AMC', 'Others', 'Warranty', 'Service', 'New Installation', 'New Inquiry', 'Site Visit'])]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
