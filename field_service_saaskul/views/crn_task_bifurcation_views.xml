<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Regular project task: Create CRN (does not modify this task). -->
        <record id="view_project_task_form_create_crn_button" model="ir.ui.view">
            <field name="name">project.task.form.create.crn.button</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_create_crn_from_task"
                            type="object"
                            string="Create CRN"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('is_fsm', '=', True), ('task_seq', '=like', 'CRN%')]}"/>
                </xpath>
                <xpath expr="//sheet" position="before">
                    <field name="is_fsm" invisible="1"/>
                    <field name="source_task_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Activity popup: Create CRN from the linked task or project. -->
        <record id="mail_activity_view_form_create_crn_button" model="ir.ui.view">
            <field name="name">mail.activity.form.create.crn.button</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
            <field name="arch" type="xml">
                <xpath expr="//footer" position="inside">
                    <button name="action_create_crn"
                            type="object"
                            string="Create CRN"
                            class="btn-secondary"
                            attrs="{'invisible': ['|', ('id', '=', False), ('res_model', 'not in', ['project.task', 'project.project'])]}"/>
                </xpath>
            </field>
        </record>

        <!-- CRN form: show FSM blocks by is_fsm (not only fsm_mode context). -->
        <record id="view_fsm_task_form_bifurcate_by_is_fsm" model="ir.ui.view">
            <field name="name">project.task.form.bifurcate.crn.by.is_fsm</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="field_service_saaskul.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <field name="is_fsm" invisible="1"/>
                    <field name="source_task_id" readonly="1"
                           attrs="{'invisible': [('source_task_id', '=', False)]}"/>
                </xpath>
                <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                    <attribute name="invisible">0</attribute>
                    <attribute name="attrs">{'invisible': [('fsm_crn_form', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//sheet/group[1]" position="attributes">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//div[@name='cpabooks_fsm_document_button_box']" position="attributes">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']" position="attributes">
                    <attribute name="attrs">{'invisible': ['&amp;', ('is_fsm', '=', False), ('check_fsm', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//div[hasclass('oe_title') and hasclass('pr-0')]//field[@name='name']" position="attributes">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Project → Tasks: never list Field Service CRNs (All CRNs menu owns them). -->
        <record id="project.action_view_task" model="ir.actions.act_window">
            <field name="domain">['&amp;', '&amp;', '|', ('project_id', '=', False), ('project_id.is_fsm', '=', False), ('check_fsm', '=', False), '!', ('task_seq', '=like', 'CRN%')]</field>
        </record>
        <record id="project.action_view_all_task" model="ir.actions.act_window">
            <field name="domain">['&amp;', '&amp;', '|', ('project_id', '=', False), ('project_id.is_fsm', '=', False), ('check_fsm', '=', False), '!', ('task_seq', '=like', 'CRN%')]</field>
        </record>
        <record id="action_project_tasks_non_fsm" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree,form,kanban,calendar,pivot,graph</field>
            <field name="domain">['&amp;', '&amp;', '|', ('project_id', '=', False), ('project_id.is_fsm', '=', False), ('check_fsm', '=', False), '!', ('task_seq', '=like', 'CRN%')]</field>
            <field name="context">{'search_default_my_tasks': 1}</field>
        </record>

    </data>
</odoo>
