<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Open full CRN form on Create (no kanban quick-create popup). -->
        <record id="view_fsm_project_task_kanban_disable_quick_create" model="ir.ui.view">
            <field name="name">project.task.kanban.fsm.disable.quick.create</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="industry_fsm.project_task_view_kanban_fsm"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="quick_create">false</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
