<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="access_fsm_material_consumption_report_all" model="ir.model.access">
        <field name="name">access_fsm_material_consumption_report_all</field>
        <field name="model_id" search="[('model', '=', 'fsm.material.consumption.report')]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="view_fsm_material_consumption_search" model="ir.ui.view">
        <field name="name">fsm.material.consumption.report.search</field>
        <field name="model">fsm.material.consumption.report</field>
        <field name="arch" type="xml">
            <search string="Consumption Analysis">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="site_location"/>
                <field name="product_id"/>
                <field name="product_categ_id"/>
                <filter name="issued" string="Issued Materials" domain="[('quantity_issued', '&gt;', 0)]"/>
                <filter name="pending" string="Pending Issue" domain="[('remaining_qty', '&gt;', 0)]"/>
                <filter name="group_product" string="Material" context="{'group_by': 'product_id'}"/>
                <filter name="group_category" string="Material Category" context="{'group_by': 'product_categ_id'}"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'site_location'}"/>
                <filter name="group_stage" string="Stage" context="{'group_by': 'fsm_stage_group'}"/>
            </search>
        </field>
    </record>

    <record id="view_fsm_material_consumption_tree" model="ir.ui.view">
        <field name="name">fsm.material.consumption.report.tree</field>
        <field name="model">fsm.material.consumption.report</field>
        <field name="arch" type="xml">
            <tree string="Consumption Analysis" create="0" edit="0" delete="0">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="site_location"/>
                <field name="product_id"/>
                <field name="product_categ_id"/>
                <field name="quantity_requested" sum="Requested"/>
                <field name="quantity_issued" sum="Issued"/>
                <field name="remaining_qty" sum="Remaining"/>
                <field name="issued_value" sum="Issued Value"/>
                <field name="fsm_stage_group"/>
                <field name="complaint_type"/>
            </tree>
        </field>
    </record>

    <record id="view_fsm_material_consumption_form" model="ir.ui.view">
        <field name="name">fsm.material.consumption.report.form</field>
        <field name="model">fsm.material.consumption.report</field>
        <field name="arch" type="xml">
            <form string="Material Consumption" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="site_location"/>
                            <field name="fsm_stage_group"/>
                            <field name="complaint_type"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_categ_id"/>
                            <field name="quantity_requested"/>
                            <field name="quantity_issued"/>
                            <field name="remaining_qty"/>
                            <field name="issued_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fsm_material_consumption_graph_material" model="ir.ui.view">
        <field name="name">fsm.material.consumption.report.graph.material</field>
        <field name="model">fsm.material.consumption.report</field>
        <field name="arch" type="xml">
            <graph string="Issued Materials by Material" type="bar" sample="1">
                <field name="product_id" type="row"/>
                <field name="quantity_issued" type="measure"/>
                <field name="quantity_requested" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_fsm_material_consumption_pivot" model="ir.ui.view">
        <field name="name">fsm.material.consumption.report.pivot</field>
        <field name="model">fsm.material.consumption.report</field>
        <field name="arch" type="xml">
            <pivot string="Consumption Analysis" sample="1">
                <field name="project_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="quantity_requested" type="measure"/>
                <field name="quantity_issued" type="measure"/>
                <field name="remaining_qty" type="measure"/>
                <field name="issued_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_fsm_material_consumption_analysis" model="ir.actions.act_window">
        <field name="name">Material Consumption Analysis</field>
        <field name="res_model">fsm.material.consumption.report</field>
        <field name="view_mode">graph,pivot,tree,form</field>
        <field name="search_view_id" ref="view_fsm_material_consumption_search"/>
        <field name="context">{}</field>
    </record>

    <record id="action_fsm_material_consumption_analysis_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_fsm_material_consumption_graph_material"/>
        <field name="act_window_id" ref="action_fsm_material_consumption_analysis"/>
    </record>

    <record id="action_fsm_material_consumption_analysis_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_fsm_material_consumption_pivot"/>
        <field name="act_window_id" ref="action_fsm_material_consumption_analysis"/>
    </record>

    <record id="action_fsm_material_consumption_analysis_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_fsm_material_consumption_tree"/>
        <field name="act_window_id" ref="action_fsm_material_consumption_analysis"/>
    </record>

    <record id="action_fsm_material_consumption_analysis_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fsm_material_consumption_form"/>
        <field name="act_window_id" ref="action_fsm_material_consumption_analysis"/>
    </record>

    <menuitem id="menu_fsm_material_consumption_analysis"
              name="Material Consumption Analysis"
              parent="industry_fsm.fsm_menu_reporting"
              sequence="12"
              action="action_fsm_material_consumption_analysis"/>

    <menuitem id="menu_fsm_material_consumption_analysis_root"
              name="Material Consumption Analysis"
              parent="industry_fsm.fsm_menu_root"
              sequence="48"
              action="action_fsm_material_consumption_analysis"/>
</odoo>
