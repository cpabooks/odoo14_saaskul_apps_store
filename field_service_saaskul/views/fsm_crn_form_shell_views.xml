<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Drop invalid subtask-hide view from failed upgrades (used @string xpath). -->
        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="['view_fsm_crn_hide_subtask_page']"/>
        </function>

        <!-- CRN form caption (Complaint Registration Form — not a project task). -->
        <record id="view_fsm_crn_form_shell" model="ir.ui.view">
            <field name="name">fsm.crn.form.shell</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="field_service_saaskul.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">25</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='cpabooks_fsm_document_button_box']" position="before">
                    <field name="fsm_crn_form" invisible="1"/>
                    <div class="cpabooks_crn_form_caption"
                         attrs="{'invisible': [('fsm_crn_form', '=', False)]}">
                        <h1 class="cpabooks_crn_form_caption_title">COMPLAINT REGISTRATION FORM</h1>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
