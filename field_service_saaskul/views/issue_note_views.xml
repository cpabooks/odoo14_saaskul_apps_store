<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="issue_tree_show_crn" model="ir.ui.view">
            <field name="name">issue.tree.show.crn</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="field_service_saaskul.issue_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="issue_crn_number" string="CRN No" optional="show"/>
                    <field name="issue_source_document" string="Source Document" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="issue_form_show_crn" model="ir.ui.view">
            <field name="name">issue.form.show.crn</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="field_service_saaskul.issue_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='issue_project_task_id']" position="attributes">
                    <attribute name="string">CRN Number</attribute>
                    <attribute name="context">{'show_task_seq': True, 'show_crn_number': True, 'strip_tid_prefix': True}</attribute>
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                    <attribute name="domain">[('material_line_ids', '!=', False), ('issue_note_done', '=', False)]</attribute>
                </xpath>
                <xpath expr="//field[@name='issue_project_task_id']" position="after">
                    <field name="issue_customer_id" string="Customer" readonly="1"/>
                    <field name="issue_source_document" string="Source Document" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='origin']" position="attributes">
                    <attribute name="string">Source Document</attribute>
                    <attribute name="readonly">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="issue_form_set_quantities" model="ir.ui.view">
            <field name="name">issue.form.set.quantities</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="field_service_saaskul.issue_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_cancel']" position="after">
                    <button name="action_set_quantities_to_reservation"
                            attrs="{'invisible': ['|', ('show_validate', '=', False), ('immediate_transfer', '=', True)]}"
                            string="Set quantities"
                            type="object"
                            groups="stock.group_stock_user"
                            class="o_btn_validate"
                            data-hotkey="g"/>
                </xpath>
            </field>
        </record>

        <!-- CRN issue notes: keep Operations + Detailed Operations even when picking type has show_operations unchecked. -->
        <record id="issue_form_fsm_operations_always" model="ir.ui.view">
            <field name="name">issue.form.fsm.operations.always</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="field_service_saaskul.issue_form"/>
            <field name="priority">40</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='show_operations']" position="after">
                    <field name="use_fsm_issue_operations_ui" invisible="1"/>
                </xpath>

                <xpath expr="//page[@name='detailed_operations_hidden']" position="attributes">
                    <attribute name="attrs">{'invisible': ['&amp;', ('use_fsm_issue_operations_ui', '=', False), '|', ('show_operations', '=', False), ('show_reserved', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='detailed_operations_shown']" position="attributes">
                    <attribute name="attrs">{'invisible': ['&amp;', ('use_fsm_issue_operations_ui', '=', False), '|', ('show_operations', '=', False), ('show_reserved', '=', False)]}</attribute>
                </xpath>

                <xpath expr="//page[@name='detailed_operations_hidden']/field[@name='move_line_nosuggest_ids']" position="attributes">
                    <attribute name="attrs">{'readonly': ['&amp;', ('use_fsm_issue_operations_ui', '=', False), '|', '|', ('show_operations', '=', False), ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='detailed_operations_shown']/field[@name='move_line_ids_without_package']" position="attributes">
                    <attribute name="attrs">{'readonly': ['&amp;', ('use_fsm_issue_operations_ui', '=', False), '|', '|', ('show_operations', '=', False), ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}</attribute>
                </xpath>

                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/tree/field[@name='show_operations']" position="after">
                    <field name="use_fsm_issue_operations_ui" invisible="1"/>
                </xpath>

                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/tree/field[@name='product_uom_qty']" position="attributes">
                    <attribute name="attrs">{'column_invisible': [('parent.immediate_transfer', '=', True)], 'readonly': ['|', ('is_initial_demand_editable', '=', False), '&amp;', ('use_fsm_issue_operations_ui', '=', False), '&amp;', '&amp;', ('show_operations', '=', True), ('is_locked', '=', True), ('is_initial_demand_editable', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/tree/button[@name='action_show_details']" position="attributes">
                    <attribute name="attrs">{'invisible': ['&amp;', ('use_fsm_issue_operations_ui', '=', False), ('show_details_visible', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/tree/button[@name='action_assign_serial']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('display_assign_serial', '=', False), '&amp;', ('use_fsm_issue_operations_ui', '=', False), ('show_operations', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/tree/field[@name='quantity_done']" position="attributes">
                    <attribute name="attrs">{'readonly': ['&amp;', ('use_fsm_issue_operations_ui', '=', False), ('is_quantity_done_editable', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
