<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_fsm_invoice_type" model="ir.ui.view">
        <field name="name">account.move.form.fsm.invoice.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="invoice_type"
                       domain="[('name', 'in', ['AMC', 'Others', 'Warranty', 'Service'])]"
                       options="{'no_create': True, 'no_create_edit': True}"
                       attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
                <field name="project_id"
                       attrs="{'invisible': [('move_type', 'not in', ['in_invoice', 'out_invoice'])]}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="guaranteed" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
