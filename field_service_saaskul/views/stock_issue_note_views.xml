<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="issue_tree" model="ir.ui.view">
        <field name="name">issue.tree</field>
        <field name="model">stock.picking</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Picking list" multi_edit="1" sample="1">
                    <header>
                        <button name="do_unreserve" type="object" string="Unreserve"/>
                    </header>
                    <field name="priority" optional="show" widget="priority" nolabel="1"/>
                    <field name="issue_project_id"/>
                    <field name="location_id" options="{'no_create': True}" string="From" groups="stock.group_stock_multi_locations" optional="show"/>
                    <field name="location_dest_id" options="{'no_create': True}" string="To" groups="stock.group_stock_multi_locations" optional="show"/>
                    <field name="partner_id" optional="show"/>
                    <field name="signature" string="Signed" optional="hide" widget="boolean" groups="stock.group_stock_sign_delivery"/>
                    <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                    <field name="scheduled_date" optional="show" widget="remaining_days" invisible="state in ('done', 'cancel')"/>
                    <field name="date_deadline" optional="hide" widget="remaining_days" invisible="state in ('done', 'cancel')"/>
                    <field name="origin" optional="show"/>
                    <field name="backorder_id" optional="hide"/>
                    <field name="picking_type_id" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                    <field name="state" optional="show" widget="badge" decoration-success="state == 'done'" decoration-info="state not in ('done', 'cancel')"/>
                    <field name="activity_exception_decoration" widget="activity_exception"/>
                    <field name="json_popover" nolabel="1" widget="stock_rescheduling_popover" invisible="not json_popover"/>
                </list>
        </field>
    </record>
    <record id="issue_form" model="ir.ui.view">
        <field name="name">issue.form</field>
        <field name="model">stock.picking</field>
        <field name="priority">21</field>
        <field name="arch" type="xml">
            <form string="Material Issue / Return Note">
                <field name="is_locked" invisible="1"/>
                <field name="show_check_availability" invisible="1"/>
                <field name="show_lots_text" invisible="1"/>
                <field name="picking_type_code" invisible="1"/>
                <field name="show_operations" invisible="1" readonly="1"/>
                <field name="picking_type_entire_packs" invisible="1"/>
                <field name="use_create_lots" invisible="1"/>

                <header>
                    <button name="action_confirm" string="Mark as Todo" type="object" class="oe_highlight" groups="base.group_user" invisible="False"/>
                    <button name="action_assign" string="Check Availability" type="object" class="oe_highlight" groups="base.group_user" invisible="not show_check_availability"/>
                    <button name="button_validate" string="Validate" type="object" class="oe_highlight" groups="stock.group_stock_user" invisible="False"/>
                    <button name="button_validate" string="Validate" type="object" groups="stock.group_stock_user" class="o_btn_validate" invisible="False"/>
                    <widget name="signature" string="Sign" highlight="1" full_name="partner_id" groups="stock.group_stock_sign_delivery" invisible="((not id or picking_type_code != 'outgoing') or state != 'done')"/>
                    <widget name="signature" string="Sign" full_name="partner_id" groups="stock.group_stock_sign_delivery" invisible="((not id or picking_type_code != 'outgoing') or state == 'done')"/>
                    <button name="do_print_picking" string="Print" groups="stock.group_stock_user" type="object" invisible="state not in ('assigned', 'partially_available')"/>
<!--                    <button name="434" string="Print" type="action" groups="base.group_user" invisible="state != 'done'"/>-->
                    <button name="%(stock.act_stock_return_picking)d" string="Return" type="action" groups="base.group_user" invisible="state != 'done'"/>
                    <button name="do_unreserve" string="Unreserved" groups="base.group_user" type="object" invisible="(((picking_type_code == 'incoming') or (state not in ('assigned', 'partially_available') and move_type != 'one')) or (state not in ('assigned', 'partially_available', 'confirmed') and move_type == 'one'))"/>
                    <button name="button_scrap" type="object" string="Scrap" invisible="((picking_type_code == 'incoming' and state != 'done') or (picking_type_code == 'outgoing' and state == 'done'))"/>
                    <button name="action_toggle_is_locked" string="Unlock" groups="stock.group_stock_manager" type="object" help="If the picking is unlocked you can edit initial demand (for a draft picking) or done quantities (for a done picking)." invisible="(state in ('draft', 'cancel') or not is_locked)"/>
                    <button name="action_toggle_is_locked" string="Lock" groups="stock.group_stock_manager" type="object" invisible="is_locked"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,assigned,done"/>
                    <button name="action_cancel" string="Cancel" groups="base.group_user" type="object" invisible="state not in ('assigned', 'confirmed', 'partially_available', 'draft', 'waiting')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="has_scrap_move" invisible="True"/>
                        <field name="has_tracking" invisible="True"/>
                        <button name="action_see_move_scrap" string="Scraps" type="object" class="oe_stat_button" icon="fa-arrows-v" invisible="not has_scrap_move"/>
                        <button name="action_see_packages" string="Packages" type="object" class="oe_stat_button" icon="fa-cubes" invisible="False"/>
<!--                        <button name="427" icon="fa-arrow-up" class="oe_stat_button" string="Traceability" type="action" groups="stock.group_production_lot" invisible="state != 'done' or not has_tracking"/>-->
                        <!-- Use the following button to avoid onchange on one2many -->
                        <button name="action_picking_move_tree" class="oe_stat_button" icon="fa-arrows-v" type="object" help="List view of operations" groups="base.group_no_one" context="{'picking_type_code': picking_type_code, 'default_picking_id': id, 'form_view_ref':'stock.view_move_form', 'address_in_id': partner_id, 'default_picking_type_id': picking_type_id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id}" invisible="((show_operations and (is_locked or state == 'done')) or (state == 'done' and is_locked))">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Operations</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="mr-3" invisible="False"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                                <field name="is_stock_issue_note" invisible="1"/>
                                <field name="is_stock_return_note" invisible="1"/>
                                <field name="stock_issue_picking_id"
                                       string="Material Issue Note (MIN)"
                                      
                                       options="{'no_create': True}"
                                       context="{'show_task_seq': True}" invisible="not is_stock_return_note" required="is_stock_return_note"/>
                                <field name="issue_project_task_id"
                                       string="CRN Number"
                                       context="{'show_task_seq': True, 'show_crn_number': True}" invisible="is_stock_return_note"/>
                            <field name="issue_project_id" string="Project/Job" options="{'no_create':True,'no_edit':True}" readonly="state != 'draft'"/>
                            <div class="o_td_label">
                                <label for="partner_id" string="Delivery Address" style="font-weight:bold;" invisible="picking_type_code != 'outgoing'"/>
                                <label for="partner_id" string="Receive From" style="font-weight:bold;" invisible="picking_type_code != 'incoming'"/>
                                <label for="partner_id" string="Customer" style="font-weight:bold;" invisible="picking_type_code in ('incoming', 'outgoing')"/>
                            </div>
                            <field name="partner_id" nolabel="1" />

                            <field name="picking_type_id"
                                   domain="[('code', '=', 'internal')]" readonly="state != 'draft'"/>
                            <field name="location_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" invisible="picking_type_code == 'incoming'"/>
                            <field name="location_dest_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" invisible="picking_type_code == 'outgoing'"/>
                            <field name="backorder_id" invisible="not backorder_id"/>

                        </group>
                        <group>
                            <label for="scheduled_date"/>
                            <div class="o_row">
                                <field name="scheduled_date" decoration-warning="state not in ('done', 'cancel') and scheduled_date &lt; now" decoration-danger="state not in ('done', 'cancel') and scheduled_date &lt; current_date" decoration-bf="state not in ('done', 'cancel') and (scheduled_date &lt; current_date or scheduled_date &lt; now)" required="id"/>
                                <field name="json_popover" widget="stock_rescheduling_popover" invisible="not json_popover"/>
                            </div>
                            <field name="date_deadline" decoration-danger="date_deadline and date_deadline &lt; current_date" decoration-bf="date_deadline and date_deadline &lt; current_date" invisible="(state in ('done', 'cancel') or not date_deadline)"/>
                            <field name="date_done" string="Effective Date" invisible="state != 'done'"/>
                            <field name="origin" placeholder="e.g. PO0032"/>
                            <field name="owner_id" groups="stock.group_tracking_owner" invisible="picking_type_code != 'incoming'"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Reservation hidden -->
                        <page string="Detailed Operations" name="detailed_operations_hidden" invisible="False">
                            <button class="oe_highlight" name="action_put_in_pack" type="object" string="Put in Pack" groups="stock.group_tracking_lot" invisible="state in ('draft', 'done', 'cancel')"/>
                        </page>

                        <!-- Reservation displayed -->
                        <page string="Detailed Operations" name="detailed_operations_shown" invisible="False">
                            <button class="oe_highlight" name="action_put_in_pack" type="object" string="Put in Pack" groups="stock.group_tracking_lot" invisible="state in ('draft', 'done', 'cancel')"/>
                        </page>

                        <page string="Operations" name="operations">
                            <field name="move_ids" mode="list,kanban" context="{'default_company_id': company_id, 'default_date': scheduled_date, 'default_date_deadline': date_deadline, 'picking_type_code': picking_type_code, 'default_picking_id': id, 'form_view_ref':'stock.view_move_form', 'address_in_id': partner_id, 'default_picking_type_id': picking_type_id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id}" readonly="state == 'done' and is_locked">
                                <list decoration-muted="state == 'cancel' or (state == 'done' and is_locked == True)" string="Stock Moves" editable="bottom">
                                    <field name="company_id" invisible="1"/>
                                    <field name="state" invisible="1" readonly="0"/>
                                    <field name="picking_type_id" invisible="1"/>
                                    <field name="location_id" invisible="1"/>
                                    <field name="location_dest_id" invisible="1"/>
                                    <field name="picking_code" invisible="1"/>
                                    <field name="show_details_visible" invisible="1"/>
                                    <field name="show_operations" invisible="1" readonly="1"/>
                                    <field name="additional" invisible="1"/>
                                    <field name="is_locked" invisible="1"/>
                                    <field name="has_tracking" invisible="1"/>
                                    <field name="display_assign_serial" invisible="1"/>
                                    <field name="product_id" required="1" context="{'default_type': 'product'}" readonly="False"/>
                                    <field name="description_picking" string="Description" optional="hide"/>
                                    <field name="date" invisible="1"/>
                                    <field name="date_deadline" optional="hide"/>
                                    <field name="is_initial_demand_editable" invisible="1"/>
                                    <field name="product_uom_qty" string="Demand" column_invisible="False" readonly="(not is_initial_demand_editable or ((show_operations and is_locked) and not is_initial_demand_editable))"/>
                                    <field name="product_qty" invisible="1" readonly="1"/>
                                    <field name="forecast_expected_date" invisible="1"/>
                                    <field name="forecast_availability" string="Reserved" widget="forecast_widget" column_invisible="parent.picking_type_code != 'outgoing' or parent.state == 'done'"/>
                                    <field name="quantity" string="Done"/>
                                    <field name="product_uom" options="{'no_open': True, 'no_create': True}" string="Unit of Measure" groups="uom.group_uom" readonly="state != 'draft' and not additional"/>
                                    <field name="rate"/>
                                    <field name="amount"/>
                                    <field name="lot_ids" widget="many2many_tags" groups="stock.group_production_lot" optional="hide" options="{'create': [('parent.use_create_lots', '=', True)]}" context="{'default_company_id': company_id, 'default_product_id': product_id, 'active_picking_id': parent.id}" domain="[('product_id','=',product_id)]" invisible="not show_details_visible or has_tracking != 'serial'"/>
                                    <button name="action_show_details" type="object" icon="fa-list" width="0.1" options="{&quot;warn&quot;: true}" invisible="not show_details_visible"/>
                                </list>
                                <form string="Stock Moves">
                                    <header>
                                        <field name="state" widget="statusbar"/>
                                    </header>
                                    <group>
                                        <field name="additional" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="product_id" required="1" readonly="False"/>
                                        <field name="is_initial_demand_editable" invisible="1"/>
                                        <field name="product_uom_qty" invisible="False" readonly="not is_initial_demand_editable"/>
                                        <field name="product_qty" invisible="1" readonly="1"/>
                                        <field name="forecast_expected_date" invisible="1"/>
                                        <field name="forecast_availability" string="Reserved" widget="forecast_widget" invisible="parent.picking_type_code != 'outgoing' or parent.state == 'done'"/>
                                        <field name="quantity" string="Done"/>
                                        <field name="product_uom" options="{'no_open': True, 'no_create': True}" string="Unit of Measure" groups="uom.group_uom" readonly="state != 'draft' and not additional"/>
                                        <field name="rate"/>
                                        <field name="amount"/>
                                        <field name="description_picking" string="Description"/>
                                    </group>
                                </form>
                            </field>
                            <field name="id" invisible="1"/>
                            <button class="oe_highlight" name="action_put_in_pack" type="object" string="Put in Pack" groups="stock.group_tracking_lot" invisible="state in ('draft', 'done', 'cancel')"/>
                        </page>
                        <page string="Material Request" name="material_request_lines">
                            <group>
                                <field name="material_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Additional Info" name="extra">
                            <group>
                                <group string="Other Information" name="other_infos">
                                    <field name="picking_type_code" invisible="1"/>
                                    <field name="move_type" invisible="picking_type_code == 'incoming'"/>
                                    <field name="user_id" domain="[('share', '=', False)]"/>
                                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" force_save="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" string="Note" placeholder="Add an internal note that will be printed on the Picking Operations sheet"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
                </form>
        </field>
    </record>

    <record id="issue_action" model="ir.actions.act_window">
        <field name="name">Material Issue Note</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
         <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('issue_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('issue_form')})]"/>
        <field name="domain">['|', ('is_stock_issue_note', '=', True), ('issue_project_task_id', '!=', False)]</field>
        <field name="context">{'default_is_stock_issue_note': True}</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            Create a Material Issue Note (MIN) to issue materials from store.
          </p>
        </field>
    </record>

    <record id="return_issue_action" model="ir.actions.act_window">
        <field name="name">Material Return Note</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('issue_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('issue_form')})]"/>
        <field name="domain">[('is_stock_return_note', '=', True)]</field>
        <field name="context">{'default_is_stock_return_note': True}</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            Create a Material Return Note (MRN). Select a Material Issue Note (MIN) to return quantities.
          </p>
        </field>
    </record>
</odoo>
