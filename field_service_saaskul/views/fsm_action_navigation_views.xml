<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_fsm_project_task_form_action_navigation" model="ir.ui.view">
            <field name="name">fsm.project.task.form.action.navigation</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="field_service_saaskul.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">25</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='cpabooks_fsm_document_button_box']" position="after">
                    <field name="is_fsm" invisible="1"/>
                    <field name="fsm_nav_completed" invisible="1"/>
                    <div class="cpabooks_fsm_nav_panel" attrs="{'invisible': [('is_fsm', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="['view_fsm_project_task_form_action_navigation_duplicate_fields']"/>
        </function>

    </data>
</odoo>
