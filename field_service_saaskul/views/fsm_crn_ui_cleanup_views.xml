<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Hide planning overlap yellow alert on CRN forms. -->
        <record id="view_fsm_crn_hide_planning_overlap" model="ir.ui.view">
            <field name="name">fsm.crn.hide.planning.overlap</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="industry_fsm.view_task_form2_inherit"/>
            <field name="priority">310</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@role='alert'][hasclass('alert-warning')][.//field[@name='planning_overlap']]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Header Create Quotation: keep visible (was force-hidden; restored in main form inherit). -->
        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="['view_fsm_crn_header_buttons_cleanup']"/>
        </function>

        <record id="view_fsm_crn_hide_industry_fsm_sale_quotation_btn" model="ir.ui.view">
            <field name="name">fsm.crn.hide.industry.sale.quotation.btn</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="industry_fsm_sale.view_task_form2_inherit"/>
            <field name="priority">320</field>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_fsm_create_quotation']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Pending banner removed: use WHAT TO DO button + dialog instead. -->
        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="['view_fsm_crn_pending_banner']"/>
        </function>

        <!-- Stage 7: costs then 38. Closing Remarks (delete first: DB may retain old approval xpaths). -->
        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="['view_fsm_crn_stage7_layout']"/>
        </function>
        <record id="view_fsm_crn_stage7_layout" model="ir.ui.view">
            <field name="name">fsm.crn.stage7.layout</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="field_service_saaskul.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">46</field>
            <field name="arch" type="xml">
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='closing_remarks']" position="replace"/>
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='total_service_cost']" position="after">
                    <field name="closing_remarks"
                           string="37. Closing Remarks"
                           attrs="{'readonly': [('fsm_stage_6_readonly', '=', True)]}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
