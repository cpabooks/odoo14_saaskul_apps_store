<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Timesheet: In/Out 24h + duration from difference -->
        <record id="view_fsm_timesheet_in_out_tree" model="ir.ui.view">
            <field name="name">fsm.timesheet.in.out.tree</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="field_service_saaskul.view_fsm_project_task_form_timesheet_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='employee_id']" position="attributes">
                    <attribute name="context">{'fsm_employee_picker': True}</attribute>
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                    <attribute name="domain">[('active', '=', True)]</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='name']" position="after">
                    <field name="fsm_time_in" widget="float_time" string="In"/>
                    <field name="fsm_time_out" widget="float_time" string="Out"/>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='unit_amount']" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/form//field[@name='employee_id']" position="attributes">
                    <attribute name="context">{'fsm_employee_picker': True}</attribute>
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                    <attribute name="domain">[('active', '=', True)]</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/form//field[@name='date']" position="after">
                    <field name="fsm_time_in" widget="float_time" string="In"/>
                    <field name="fsm_time_out" widget="float_time" string="Out"/>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/form//field[@name='unit_amount']" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Assigned to + Visited by: employee only, no quick create -->
        <record id="view_fsm_task_employee_assignee_fields" model="ir.ui.view">
            <field name="name">fsm.task.employee.assignee.fields</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="field_service_saaskul.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">40</field>
            <field name="arch" type="xml">

                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='visited_by']" position="attributes">
                    <attribute name="widget">many2one_avatar_employee</attribute>
                    <attribute name="context">{'fsm_employee_picker': True}</attribute>
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                    <attribute name="domain">[('active', '=', True)]</attribute>
                </xpath>

                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='fsm_assigned_employee_id']" position="attributes">
                    <attribute name="widget">many2one_avatar_employee</attribute>
                    <attribute name="context">{'fsm_employee_picker': True}</attribute>
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                    <attribute name="domain">[('active', '=', True)]</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
