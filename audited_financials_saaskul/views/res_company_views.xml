<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_afg_auditor" model="ir.ui.view">
        <field name="name">res.company.form.afg.auditor</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cpabooks Audited Financials" name="afg_auditor">
                    <group string="Independent Auditor's Report">
                        <field name="afg_auditor_firm" placeholder="e.g. ABC &amp; Co."/>
                        <field name="afg_auditor_signatory" placeholder="e.g. Mr. John Doe"/>
                        <field name="afg_auditor_designation"/>
                        <field name="afg_auditor_licence"/>
                    </group>
                    <div class="text-muted">
                        Printed at the end of the auditor's report in the Audited Financials PDF and Word pack.
                        Empty fields are left out.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
