<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_cpa_coa_ifrs_coding" model="ir.actions.server">
        <field name="name">IFRS Reset / Recode</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env['account.account'].with_context(active_ids=env.context.get('active_ids', [])).cpa_coa_menu_ifrs_coding()
        </field>
    </record>

    <record id="view_coa_ifrs_reset_confirm_wizard_form" model="ir.ui.view">
        <field name="name">coa.ifrs.reset.confirm.wizard.form</field>
        <field name="model">coa.ifrs.reset.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset &amp; Regenerate COA Coding">
                <field name="account_ids" invisible="1"/>
                <field name="company_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="message" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_preview_new_codes" type="object"
                            string="Preview New Codes" class="btn-primary"/>
                    <button name="action_reset_and_generate" type="object"
                            string="Reset &amp; Generate" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coa_ifrs_coding_wizard_form" model="ir.ui.view">
        <field name="name">coa.ifrs.coding.wizard.form</field>
        <field name="model">coa.ifrs.coding.wizard</field>
        <field name="arch" type="xml">
            <form string="IFRS Reset / Recode">
                <field name="state" invisible="1"/>
                <group attrs="{'invisible': [('state', '!=', 'options')]}">
                    <field name="account_ids" invisible="1"/>
                    <field name="company_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           domain="[('id', 'in', allowed_company_ids)]"/>
                    <field name="update_groups" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'options')]}">
                    <p class="mb-0">
                        <strong>L3 Ledger</strong> (4 digits): IFRS group code + sequence, e.g. 5801.
                        <strong>BC</strong> is separate and is not part of the ledger code.
                        Journal entries are not changed.
                    </p>
                </div>
                <footer attrs="{'invisible': [('state', '!=', 'options')]}">
                    <button name="action_preview" type="object" string="Preview New Codes" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coa_ifrs_coding_preview_form" model="ir.ui.view">
        <field name="name">coa.ifrs.coding.wizard.preview</field>
        <field name="model">coa.ifrs.coding.wizard</field>
        <field name="arch" type="xml">
            <form string="IFRS Reset / Recode Preview">
                <field name="message" nolabel="1" readonly="1"/>
                <field name="state" invisible="1"/>
                <field name="update_groups" invisible="1"/>
                <field name="company_ids" invisible="1"/>
                <field name="account_ids" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <tree string="Preview" create="0" delete="0" edit="1" decoration-warning="issue != 'ok'">
                        <field name="current_code" string="Old Code"/>
                        <field name="proposed_code" string="New Code"/>
                        <field name="name" string="Ledger Name"/>
                        <field name="branch_code" string="BC"/>
                        <field name="branch_digit" string="Co." optional="hide"/>
                        <field name="company_id" string="Company / Branch"/>
                        <field name="user_type_id" string="Account Type"/>
                        <field name="proposed_group_code" string="Group Code"/>
                        <field name="proposed_group_name" string="Group"/>
                        <field name="bs_pl" string="B/P"/>
                        <field name="current_code" string="Current Code" optional="show"/>
                        <field name="name_needs_review" invisible="1"/>
                        <field name="suggested_name" optional="show"/>
                        <field name="edited_name" attrs="{'invisible': [('name_needs_review', '=', False)]}"/>
                        <field name="name_action"
                               attrs="{'invisible': [('name_needs_review', '=', False)]}"/>
                        <field name="previous_name" optional="hide"/>
                        <field name="issue" optional="show"/>
                        <field name="account_id" invisible="1"/>
                        <field name="group_id" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply IFRS Recode" class="btn-primary"
                            confirm="Apply IFRS recode? Old codes are backed up on each ledger and logged in chatter."/>
                    <button name="action_preview" type="object" string="Refresh Preview" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coa_ifrs_name_suggestion_wizard_form" model="ir.ui.view">
        <field name="name">coa.ifrs.name.suggestion.wizard.form</field>
        <field name="model">coa.ifrs.name.suggestion.wizard</field>
        <field name="arch" type="xml">
            <form string="IFRS naming suggestion">
                <field name="message" nolabel="1" readonly="1"/>
                <group>
                    <field name="account_id" invisible="1"/>
                    <field name="group_id" invisible="1"/>
                    <field name="current_name" string="Current name" readonly="1"/>
                    <field name="suggested_name" string="Suggested name" readonly="1"/>
                    <field name="edited_name"/>
                    <field name="previous_name" readonly="1"
                           attrs="{'invisible': [('previous_name', '=', False)]}"/>
                </group>
                <footer>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary"/>
                    <button name="action_edit" type="object" string="Edit" class="btn-secondary"/>
                    <button name="action_skip" type="object" string="Skip" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_cpa_coa_ifrs_coding"
              name="IFRS Reset / Recode"
              parent="menu_cpa_coa_root"
              action="action_cpa_coa_ifrs_coding"
              sequence="142"
              groups="account.group_account_manager,base.group_system"/>
</odoo>
