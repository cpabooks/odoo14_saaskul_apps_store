<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_cpa_coa_add_opening_balance" model="ir.actions.server">
        <field name="name">Add Opening Balance</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env['account.account'].cpa_coa_menu_add_opening_balance()
        </field>
    </record>

    <menuitem id="menu_cpa_coa_add_opening_balance"
              name="Add Opening Balance"
              parent="menu_cpa_coa_root"
              action="action_cpa_coa_add_opening_balance"
              sequence="25"
              groups="account.group_account_manager,account.group_account_user"/>

    <record id="view_account_move_form_opening_balance" model="ir.ui.view">
        <field name="name">account.move.form.opening.balance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="cpabooks_is_opening_balance" invisible="1"/>
            </field>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="after">
                <field name="cpabooks_opening_auto_re" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                <attribute name="decoration-info">cpabooks_opening_auto_re</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='debit']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('cpabooks_opening_auto_re', '=', True), ('credit', '!=', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='credit']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('cpabooks_opening_auto_re', '=', True), ('debit', '!=', 0)]}</attribute>
            </xpath>
            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']" position="after">
                <div class="o_cpabooks_jv_narration"
                     style="border: 1px solid #6c757d; border-radius: 4px; padding: 10px; margin-top: 8px;"
                     attrs="{'invisible': [('move_type', '!=', 'entry')]}">
                    <label for="narration" string="Narration:" class="font-weight-bold"/>
                    <field name="narration" nolabel="1"
                           placeholder="Narration / internal note..."
                           class="text-break w-100"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
