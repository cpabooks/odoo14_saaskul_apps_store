    <record id="view_coa_reset_code_preview_wizard_form" model="ir.ui.view">
        <field name="name">coa.reset.code.preview.wizard.form</field>
        <field name="model">coa.reset.code.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Code Digits Preview">
                <field name="message" readonly="1" nolabel="1"/>
                <field name="line_ids" nolabel="1" readonly="1">
                    <tree create="false" edit="false" delete="false"
                          decoration-danger="issue == 'company_duplicate'"
                          decoration-info="issue == 'changed'"
                          decoration-success="issue == 'ok'">
                        <field name="company_id"/>
                        <field name="current_code"/>
                        <field name="suggested_code"/>
                        <field name="name"/>
                        <field name="user_type_id"/>
                        <field name="group_key"/>
                        <field name="issue"/>
                        <field name="suggested_fix"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_apply_reset"
                            type="object"
                            string="Apply Reset"
                            class="btn-primary"
                            confirm="This will update account codes using the suggested digit-only codes. Continue?"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coa_bulk_delete_wizard_form" model="ir.ui.view">
        <field name="name">coa.bulk.delete.wizard.form</field>
        <field name="model">coa.bulk.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Move entries and delete">
                <field name="bulk_wizard_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="account_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Selected ledgers have journal entries. Move them to another ledger,
                    then delete the source ledgers. A target is suggested when possible.
                </div>
                <field name="summary_html" nolabel="1" readonly="1"/>
                <group>
                    <field name="suggested_target_id" readonly="1"
                           attrs="{'invisible': [('suggested_target_id', '=', False)]}"/>
                    <field name="target_account_id"
                           options="{'no_create': True}"
                           placeholder="Ledger that will keep the journal entries"/>
                </group>
                <footer>
                    <button name="action_move_and_delete"
                            type="object"
                            string="Move entries and delete"
                            class="btn-primary"
                            confirm="Journal items will be moved to the target ledger and the selected ledgers will be removed. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coa_delete_unused_wizard_form" model="ir.ui.view">
        <field name="name">coa.delete.unused.wizard.form</field>
        <field name="model">coa.bulk.actions.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Unused COA">
                <field name="operation_mode" invisible="1"/>
                <field name="account_ids" invisible="1"/>
                <field name="show_company_selector" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    Use <strong>Select all unused</strong>, then <strong>Delete</strong>.
                    Unused ledgers are removed; if Odoo blocks delete, they are <strong>archived</strong> instead.
                    Ledgers with journal items open <strong>move entries</strong> (target ledger suggested).
                    Uncheck <strong>Show only unused</strong> to include ledgers that already have entries.
                </div>
                <field name="message" readonly="1" nolabel="1" attrs="{'invisible': [('message', '=', False)]}"/>
                <group>
                    <field name="company_id"
                           options="{'no_create': True}"
                           attrs="{'invisible': [('show_company_selector', '=', False)]}"/>
                    <field name="show_only_unused"/>
                </group>
                <notebook>
                    <page string="Company ledgers">
                        <field name="line_ids" nolabel="1" mode="tree" limit="20"
                               options="{'no_open': True, 'no_create': True}">
                            <tree editable="bottom" create="false" delete="false" limit="20"
                                  decoration-success="not is_used"
                                  decoration-muted="is_used">
                                <field name="selected" string="Select"/>
                                <field name="account_id" invisible="1"/>
                                <field name="is_used" invisible="1"/>
                                <field name="can_delete" invisible="1"/>
                                <field name="code" string="LCODE" readonly="1"/>
                                <field name="name" string="Account" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="user_type_id" string="Type" readonly="1"/>
                                <field name="group_id" string="Group" readonly="1" optional="show"/>
                                <field name="move_line_count" readonly="1"/>
                                <field name="balance" readonly="1"/>
                                <field name="usage_label" string="Status" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <group string="Selection">
                    <button name="action_select_all_unused" type="object" string="Select all unused"
                            class="btn-secondary"/>
                    <button name="action_select_all_visible" type="object" string="Select all on page"
                            class="btn-secondary"/>
                    <button name="action_clear_selection" type="object" string="Clear selection"
                            class="btn-secondary"/>
                </group>
                <group string="Actions on selected rows">
                    <button name="action_delete_selected" type="object" string="Delete" class="btn-primary"/>
                    <button name="action_archive_selected" type="object" string="Archive" class="btn-secondary"
                            confirm="Mark the selected ledgers as deprecated (archived). Use when delete is blocked. Continue?"/>
                    <button name="action_refresh" type="object" string="Refresh list" class="btn-secondary"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coa_bulk_actions_wizard_form" model="ir.ui.view">
        <field name="name">coa.bulk.actions.wizard.form</field>
        <field name="model">coa.bulk.actions.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge COA">
                <field name="operation_mode" invisible="1"/>
                <field name="account_ids" invisible="1"/>
                <field name="show_company_selector" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <strong>Merge from</strong> is filled with the ledger(s) you opened this from, and
                    <strong>Merge into</strong> is suggested — change either field if needed, then press <strong>Merge</strong>.
                    The list below shows only those ledgers; untick <strong>Show only merge ledgers</strong> to browse the whole company.
                    On the full list you can tick <strong>Select</strong> and use <strong>Archive</strong> (mark deprecated) or
                    <strong>Delete</strong> (removes unused ledgers, or opens a dialog to move journal items first).
                </div>
                <field name="message" readonly="1" nolabel="1" attrs="{'invisible': [('message', '=', False)]}"/>
                <group>
                    <field name="company_id"
                           options="{'no_create': True}"
                           attrs="{'invisible': [('show_company_selector', '=', False)]}"/>
                    <field name="source_account_ids"
                           string="Merge from"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           domain="[('company_id', '=', company_id), ('id', '!=', target_account_id)]"
                           placeholder="Source ledger(s) to remove"/>
                    <field name="target_account_id"
                           string="Merge into"
                           domain="[('company_id', '=', company_id)]"
                           options="{'no_create': True}"
                           placeholder="Target ledger to keep"/>
                    <field name="limit_to_merge_ledgers"/>
                </group>
                <notebook>
                    <page string="Company ledgers">
                        <field name="line_ids"
                               nolabel="1"
                               mode="tree"
                               options="{'no_open': True, 'no_create': True}">
                            <tree editable="bottom"
                                  create="false"
                                  delete="false"
                                  decoration-success="not is_used"
                                  decoration-muted="is_used">
                                <field name="selected" string="Select"/>
                                <field name="account_id" invisible="1"/>
                                <field name="is_used" invisible="1"/>
                                <field name="can_delete" invisible="1"/>
                                <field name="code" readonly="1"/>
                                <field name="name" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="user_type_id" readonly="1"/>
                                <field name="group_id" readonly="1" optional="hide"/>
                                <field name="move_line_count" readonly="1"/>
                                <field name="usage_label" string="Status" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <group string="Actions on selected rows">
                    <button name="action_merge_coa"
                            type="object"
                            string="Merge"
                            class="btn-primary"
                            confirm="Move all journal items from the source ledger(s) into the target ledger and remove the source ledger(s). Continue?"/>
                    <button name="action_archive_selected"
                            type="object"
                            string="Archive"
                            class="btn-secondary"
                            confirm="Mark the selected ledgers as deprecated (archived). Continue?"/>
                    <button name="action_delete_selected"
                            type="object"
                            string="Delete"
                            class="btn-secondary"/>
                    <button name="action_refresh"
                            type="object"
                            string="Refresh list"
                            class="btn-secondary"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
