<odoo>
<record id="closing_tree" model="ir.ui.view"><field name="name">closing.tree</field><field name="model">saaskul.recipe.closing</field><field name="arch" type="xml"><tree editable="bottom" decoration-success="state=='ok'" decoration-warning="state=='warning'" decoration-danger="state=='variance'"><field name="date"/><field name="branch"/><field name="product_id"/><field name="opening_qty"/><field name="purchase_qty"/><field name="transfer_in_qty"/><field name="transfer_out_qty"/><field name="waste_qty"/><field name="theoretical_consumption"/><field name="expected_closing_qty"/><field name="actual_closing_qty"/><field name="actual_consumption"/><field name="variance_qty"/><field name="variance_pct"/><field name="state"/></tree></field></record>
<record id="action_closing" model="ir.actions.act_window"><field name="name">Daily Closing Stock</field><field name="res_model">saaskul.recipe.closing</field><field name="view_mode">tree,form,pivot,graph</field></record>
<record id="cons_tree" model="ir.ui.view"><field name="name">cons.tree</field><field name="model">saaskul.recipe.consumption</field><field name="arch" type="xml"><tree><field name="date"/><field name="branch"/><field name="sale_product_id"/><field name="recipe_id"/><field name="ingredient_id"/><field name="sold_qty"/><field name="recipe_qty"/><field name="theoretical_qty"/><field name="unit_cost"/><field name="theoretical_cost"/><field name="sales_value"/><field name="potential_cost_pct"/></tree></field></record>
<record id="cons_pivot" model="ir.ui.view"><field name="name">cons.pivot</field><field name="model">saaskul.recipe.consumption</field><field name="arch" type="xml"><pivot string="Consumption Analysis"><field name="date" type="row" interval="month"/><field name="branch" type="row"/><field name="ingredient_id" type="row"/><field name="theoretical_qty" type="measure"/><field name="theoretical_cost" type="measure"/><field name="sales_value" type="measure"/></pivot></field></record>
<record id="action_consumption" model="ir.actions.act_window"><field name="name">Consumption Analysis</field><field name="res_model">saaskul.recipe.consumption</field><field name="view_mode">tree,pivot,graph</field></record>
</odoo>
