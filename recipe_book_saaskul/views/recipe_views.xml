<odoo>
<record id="recipe_tree" model="ir.ui.view"><field name="name">recipe.tree</field><field name="model">saaskul.recipe</field><field name="arch" type="xml"><tree decoration-success="potential_cost_pct &lt;= 30" decoration-warning="potential_cost_pct &gt; 30"><field name="image_1920" widget="image"/><field name="name"/><field name="branch"/><field name="sale_product_id"/><field name="standard_cost"/><field name="selling_price"/><field name="potential_cost_pct"/><field name="margin"/></tree></field></record>
<record id="recipe_form" model="ir.ui.view"><field name="name">recipe.form</field><field name="model">saaskul.recipe</field><field name="arch" type="xml"><form string="Recipe Book"><header><button name="action_sales" type="object" string="Sales of this Menu" class="oe_highlight"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="sale_product_id"/></h2></div><group><group><field name="code"/><field name="company_id"/><field name="branch"/><field name="category"/></group><group><field name="image_1920" widget="image" class="oe_avatar"/><field name="selling_price"/><field name="standard_cost"/><field name="potential_cost_pct"/><field name="margin"/></group></group><notebook><page string="Ingredients"><field name="line_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="product_id"/><field name="qty"/><field name="uom_id"/><field name="unit_cost"/><field name="line_cost"/></tree></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet></form></field></record>
<record id="action_recipe" model="ir.actions.act_window"><field name="name">Menu Book</field><field name="res_model">saaskul.recipe</field><field name="view_mode">tree,form</field></record>
<record id="prep_tree" model="ir.ui.view"><field name="name">prep.tree</field><field name="model">saaskul.prep.recipe</field><field name="arch" type="xml"><tree><field name="code"/><field name="name"/><field name="product_id"/><field name="batch_yield"/><field name="uom_id"/><field name="batch_cost"/><field name="unit_cost"/></tree></field></record>
<record id="prep_form" model="ir.ui.view"><field name="name">prep.form</field><field name="model">saaskul.prep.recipe</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="product_id"/><field name="batch_yield"/><field name="uom_id"/><field name="batch_cost"/><field name="unit_cost"/></group><field name="line_ids"><tree editable="bottom"><field name="product_id"/><field name="qty"/><field name="uom_id"/><field name="unit_cost"/><field name="line_cost"/></tree></field></sheet></form></field></record>
<record id="action_prep" model="ir.actions.act_window"><field name="name">Prep &amp; Sub-Recipes</field><field name="res_model">saaskul.prep.recipe</field><field name="view_mode">tree,form</field></record>
</odoo>
