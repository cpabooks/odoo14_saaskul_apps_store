<odoo>
<record id="dashboard_kanban" model="ir.ui.view"><field name="name">recipe.dashboard.kanban</field><field name="model">saaskul.recipe</field><field name="arch" type="xml"><kanban><field name="name"/><field name="image_1920"/><field name="selling_price"/><field name="standard_cost"/><field name="potential_cost_pct"/><templates><t t-name="kanban-box"><div class="oe_kanban_global_click o_kanban_record"><div class="o_kanban_image"><img t-att-src="kanban_image('saaskul.recipe','image_1920',record.id.raw_value)"/></div><div class="oe_kanban_details"><strong><field name="name"/></strong><div>Sell: <field name="selling_price"/></div><div>Standard cost: <field name="standard_cost"/></div><div>Potential: <field name="potential_cost_pct"/>%</div></div></div></t></templates></kanban></field></record>
<record id="action_dashboard" model="ir.actions.act_window"><field name="name">Recipe Book Dashboard</field><field name="res_model">saaskul.recipe</field><field name="view_mode">kanban,tree,form</field></record>
</odoo>
