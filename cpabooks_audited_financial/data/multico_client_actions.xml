        <field name="name">Profit and Loss_x</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'model': 'account.financial.html.report', 'project_multicompany_no_session': True, 'project_multicompany_kind': 'pl'}"/>
    </record>
    <record id="action_afg_multico_balance_sheet" model="ir.actions.client">
        <field name="name">Balance Sheet_x</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'model': 'account.financial.html.report', 'project_multicompany_no_session': True, 'project_multicompany_kind': 'bs'}"/>
    </record>
</odoo>
