<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audited_financial_ledger_merge_wizard_form" model="ir.ui.view">
        <field name="name">audited.financial.ledger.merge.wizard.form</field>
        <field name="model">audited.financial.ledger.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Ledger">
                <group>
                    <field name="version_id" invisible="1"/>
                    <field name="report_section" readonly="1"/>
                    <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="focus_company_id" options="{'no_create': True}"/>
                    <field name="filter_mode" widget="radio"/>
                    <field name="afg_group_ids" widget="many2many_tags" options="{'no_create': True}"
                             attrs="{'invisible': [('filter_mode', '!=', 'afg_group')]}"/>
                    <field name="account_group_ids" widget="many2many_tags" options="{'no_create': True}"
                             attrs="{'invisible': [('filter_mode', '!=', 'account_group')]}"/>
                    <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"
                             domain="[('company_id', 'in', company_ids), ('deprecated', '=', False)]"
                             attrs="{'invisible': [('filter_mode', '!=', 'ledger')]}"/>
                    <field name="line_count"/>
                </group>
                <group string="Action">
                    <field name="action_mode" widget="radio"/>
                    <field name="merge_into_id" options="{'no_create': True}"
                             domain="[('company_id', 'in', company_ids), ('deprecated', '=', False)]"
                             attrs="{'invisible': [('action_mode', '!=', 'merge')]}"
                             placeholder="Select ledger to keep / merge into"/>
                </group>
                <div class="alert alert-info" role="status" attrs="{'invisible': [('info_message', '=', False)]}">
                    <field name="info_message" nolabel="1" readonly="1"/>
                </div>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="1">
                        <field name="include"/>
                        <field name="company_id" readonly="1"/>
                        <field name="account_id" optional="hide" readonly="1"/>
                        <field name="current_name"/>
                        <field name="balance" readonly="1" sum="Balance"/>
                        <field name="jv_qty" readonly="1" sum="JV Qty"/>
                        <field name="line_state" readonly="1"/>
                        <field name="sequence" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_load_ledgers" type="object" string="Load ledgers" class="btn-primary"/>
                    <button name="action_save" type="object" string="Save"
                            class="btn-secondary"
                            attrs="{'invisible': [('action_mode', '!=', 'modify')]}"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-warning"
                            attrs="{'invisible': [('action_mode', '!=', 'modify')]}"/>
                    <button name="action_merge" type="object" string="Merge"
                            class="btn-warning"
                            attrs="{'invisible': [('action_mode', '!=', 'merge')]}"/>
                    <button name="action_archive" type="object" string="Archive"
                            class="btn-secondary"
                            attrs="{'invisible': [('action_mode', '!=', 'archive')]}"
                            confirm="Archive (deprecate) the included ledger(s)?"/>
                    <button name="action_delete" type="object" string="Delete"
                            class="btn-danger"
                            attrs="{'invisible': [('action_mode', '!=', 'delete')]}"
                            confirm="Permanently delete included ledger(s) with zero Balance and JV Qty? Linked ones will be archived instead."/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
