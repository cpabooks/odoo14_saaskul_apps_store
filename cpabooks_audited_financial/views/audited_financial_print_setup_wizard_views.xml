<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audited_financial_print_setup_wizard_form" model="ir.ui.view">
        <field name="name">audited.financial.print.setup.wizard.form</field>
        <field name="model">audited.financial.print.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Setup">
                <sheet>
                    <group>
                        <group>
                            <field name="print_company_name"/>
                            <field name="print_show_page_numbers"/>
                            <field name="version_id" invisible="1"/>
                        </group>
                        <group>
                            <p class="text-muted">
                                All pages are included by default. Uncheck a page to skip it
                                (for example Corporate Tax Filing). Page numbers stay off unless you tick them.
                            </p>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_include_all" type="object" string="Include all pages" class="btn-secondary"/>
                        <button name="action_exclude_fta" type="object" string="Exclude CT filing" class="btn-secondary"/>
                    </div>
                    <separator string="Pages to print (preview)"/>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="include_page" widget="boolean_toggle" string="Include"/>
                            <field name="name"/>
                            <field name="preview_text"/>
                            <field name="page_key" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                    <button name="action_save_setup" type="object" string="Save" class="btn-primary"/>
                    <button name="action_preview_pdf" type="object" string="Preview PDF" class="btn-primary"/>
                    <button name="action_preview_xlsx" type="object" string="Preview Excel" class="btn-secondary"/>
                    <button name="action_preview_docx" type="object" string="Preview Word" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
