<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fsm_task_analysis_graph" model="ir.ui.view">
        <field name="name">project.task.graph.fsm.monitor</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="CRN Analysis" type="bar" sample="1">
                <field name="fsm_stage_group" type="row"/>
                <field name="complaint_type" type="col"/>
                <field name="timesheet_cost_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_fsm_task_analysis_pivot" model="ir.ui.view">
        <field name="name">project.task.pivot.fsm.monitor</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="CRN Analysis" sample="1">
                <field name="fsm_stage_group" type="row"/>
                <field name="user_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="timesheet_cost_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_fsm_task_analysis_monitor" model="ir.actions.act_window">
        <field name="name">CRN Monitor</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_fsm', '=', True)]</field>
        <field name="context">{
            'fsm_mode': True,
            'show_address': True,
            'search_default_my_tasks': False,
            'search_default_planned_future': False,
            'search_default_planned_today': False,
            'fsm_task_kanban_whole_date': False,
        }</field>
        <field name="search_view_id" ref="saaskul_field_service.project_task_view_search_fsm_inherit_admin"/>
    </record>

    <record id="action_fsm_task_analysis_monitor_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="industry_fsm.project_task_view_list_fsm"/>
        <field name="act_window_id" ref="action_fsm_task_analysis_monitor"/>
    </record>

    <record id="action_fsm_task_analysis_monitor_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_fsm_task_analysis_graph"/>
        <field name="act_window_id" ref="action_fsm_task_analysis_monitor"/>
    </record>

    <record id="action_fsm_task_analysis_monitor_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_fsm_task_analysis_pivot"/>
        <field name="act_window_id" ref="action_fsm_task_analysis_monitor"/>
    </record>

    <record id="view_fsm_timesheet_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.fsm.monitor</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree string="FSM Timesheets">
                <field name="currency_id" invisible="1"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="name"/>
                <field name="unit_amount" widget="timesheet_uom"/>
                <field name="fsm_cost_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_fsm_timesheet_pivot" model="ir.ui.view">
        <field name="name">account.analytic.line.pivot.fsm.monitor</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <pivot string="FSM Timesheets" sample="1">
                <field name="employee_id" type="row"/>
                <field name="task_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="unit_amount" type="measure" widget="timesheet_uom"/>
                <field name="fsm_cost_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fsm_timesheet_graph" model="ir.ui.view">
        <field name="name">account.analytic.line.graph.fsm.monitor</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <graph string="FSM Timesheets" type="bar" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="fsm_cost_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fsm_timesheet_analysis_monitor" model="ir.actions.act_window">
        <field name="name">Service Timesheet Analysis</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="domain">[('task_id.is_fsm', '=', True)]</field>
        <field name="search_view_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="context">{'search_default_month': 1}</field>
    </record>

    <record id="action_fsm_timesheet_analysis_monitor_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_fsm_timesheet_tree"/>
        <field name="act_window_id" ref="action_fsm_timesheet_analysis_monitor"/>
    </record>

    <record id="action_fsm_timesheet_analysis_monitor_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_fsm_timesheet_pivot"/>
        <field name="act_window_id" ref="action_fsm_timesheet_analysis_monitor"/>
    </record>

    <record id="action_fsm_timesheet_analysis_monitor_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_fsm_timesheet_graph"/>
        <field name="act_window_id" ref="action_fsm_timesheet_analysis_monitor"/>
    </record>

    <record id="action_fsm_service_monitor_dashboard" model="ir.actions.client">
        <field name="name">Service Dashboard</field>
        <field name="tag">fsm_service_monitor_dashboard</field>
    </record>

    <menuitem id="menu_fsm_service_monitor_dashboard"
              name="Service Dashboard"
              parent="industry_fsm.fsm_menu_reporting"
              sequence="5"
              action="action_fsm_service_monitor_dashboard"
              groups="industry_fsm.group_fsm_manager"/>

    <menuitem id="menu_fsm_task_analysis_monitor"
              name="Service Task Analysis"
              parent="industry_fsm.fsm_menu_reporting"
              sequence="15"
              action="action_fsm_task_analysis_monitor"
              groups="industry_fsm.group_fsm_manager"/>

    <menuitem id="menu_fsm_timesheet_analysis_monitor"
              name="Service Timesheet Analysis"
              parent="industry_fsm.fsm_menu_reporting"
              sequence="20"
              action="action_fsm_timesheet_analysis_monitor"
              groups="industry_fsm.group_fsm_manager"/>

    <template id="assets_fsm_dashboard" inherit_id="web.assets_backend" name="FSM Dashboard assets">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/web/static/lib/Chart/Chart.js"/>
            <script type="text/javascript" src="/saaskul_field_service/static/src/js/fsm_dashboard.js"/>
            <link rel="stylesheet" href="/saaskul_field_service/static/src/css/fsm_dashboard.css"/>
        </xpath>
    </template>
</odoo>
