<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_fsm_cancel_selected_tasks" model="ir.actions.server">
        <field name="name">Cancel Selected</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">records.action_fsm_cancel_selected()</field>
    </record>

    <record id="action_fsm_cancel_all_tasks" model="ir.actions.server">
        <field name="name">Cancel All CRNs</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">env['project.task'].action_fsm_cancel_all_tasks()</field>
    </record>

    <record id="action_fsm_cancel_all_tasks_with_related" model="ir.actions.server">
        <field name="name">Cancel All CRNs Including Related</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">env['project.task'].action_fsm_cancel_all_tasks_with_related()</field>
    </record>

    <record id="action_fsm_delete_selected_crns" model="ir.actions.server">
        <field name="name">Delete CRN(s)</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('industry_fsm.group_fsm_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_fsm_delete_selected()</field>
    </record>

    <record id="action_fsm_archive_selected_crns" model="ir.actions.server">
        <field name="name">Archive CRN(s)</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('industry_fsm.group_fsm_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_fsm_archive_selected()</field>
    </record>
</odoo>
