<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_fsm_crn_cost_fields_overview" model="ir.ui.view">
            <field name="name">fsm.crn.cost.fields.overview</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="saaskul_field_service.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">45</field>
            <field name="arch" type="xml">
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='timesheet_cost_total']" position="after">
                    <field name="currency_id" invisible="1"/>
                    <field name="fsm_transport_cost" string="34. Transport Cost" attrs="{'readonly': [('fsm_stage_6_readonly', '=', True)]}"/>
                    <field name="fsm_other_cost" string="35. Other Cost" attrs="{'readonly': [('fsm_stage_6_readonly', '=', True)]}"/>
                </xpath>
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='material_cost_total']" position="attributes">
                    <attribute name="class">cpabooks_fsm_cost_line</attribute>
                </xpath>
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='timesheet_cost_total']" position="attributes">
                    <attribute name="class">cpabooks_fsm_cost_line</attribute>
                </xpath>
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='fsm_transport_cost']" position="attributes">
                    <attribute name="class">cpabooks_fsm_cost_line</attribute>
                </xpath>
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='fsm_other_cost']" position="attributes">
                    <attribute name="class">cpabooks_fsm_cost_line</attribute>
                </xpath>
                <xpath expr="//group[contains(@class, 'cpabooks_fsm_stage_panel_6')]//field[@name='total_service_cost']" position="attributes">
                    <attribute name="string">36. Total Actual + Estimated Cost</attribute>
                    <attribute name="class">cpabooks_fsm_cost_total_grand</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
