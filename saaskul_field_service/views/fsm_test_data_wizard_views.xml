<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fsm_test_data_wizard_form" model="ir.ui.view">
        <field name="name">cpabooks.fsm.test.data.wizard.form</field>
        <field name="model">cpabooks.fsm.test.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Test Data">
                <group>
                    <field name="name" invisible="1"/>
                    <field name="last_result" nolabel="1" readonly="1"
                           placeholder="Use the buttons below to generate or clean field service test data."/>
                </group>
                <footer>
                    <button name="action_generate_test_data"
                            string="Run Test Data"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_clean_test_data"
                            string="Clean Test Data"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fsm_test_data_wizard" model="ir.actions.act_window">
        <field name="name">Run Test Data</field>
        <field name="res_model">cpabooks.fsm.test.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_fsm_run_test_data"
              name="Run Test Data"
              parent="industry_fsm.fsm_menu_settings"
              action="action_fsm_test_data_wizard"
              sequence="95"
              groups="industry_fsm.group_fsm_manager"/>
</odoo>
