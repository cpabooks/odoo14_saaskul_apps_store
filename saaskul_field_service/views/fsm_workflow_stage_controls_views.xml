<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_fsm_project_task_form_workflow_stage_controls" model="ir.ui.view">
            <field name="name">fsm.project.task.form.workflow.stage.controls</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="saaskul_field_service.view_fsm_project_task_form_view_inherit"/>
            <field name="priority">35</field>
            <field name="arch" type="xml">

                <xpath expr="//group[@class='cpabooks_fsm_overview']" position="inside">
                    <field name="fsm_ui_active_stage" invisible="1"/>
                    <field name="fsm_workflow_edit_mode" invisible="1"/>
                    <field name="fsm_stage_0_readonly" invisible="1"/>
                    <field name="fsm_stage_1_readonly" invisible="1"/>
                    <field name="fsm_stage_2_readonly" invisible="1"/>
                    <field name="fsm_stage_3_readonly" invisible="1"/>
                    <field name="fsm_stage_4_readonly" invisible="1"/>
                    <field name="fsm_stage_5_readonly" invisible="1"/>
                    <field name="fsm_stage_6_readonly" invisible="1"/>
                </xpath>

                <!-- Stage 0 — Registration -->
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='site_location']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='client_person']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='client_contact']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='client_email']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='complaint_type']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='invoice_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='qt_no']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)], 'invisible': [('available_quotation_ids', '=', False)], 'required': [('complaint_type', '=', 'new_installation'), ('available_quotation_ids', '!=', False)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='qt_no_text']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)], 'invisible': [('available_quotation_ids', '!=', False)], 'required': [('complaint_type', '=', 'new_installation'), ('available_quotation_ids', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='item_des']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='invoice_type']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='project_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='complaint_title']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='complaint_details']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='deadline']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='importance']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='total_print_row']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_0_readonly', '=', True)]}</attribute>
                </xpath>

                <!-- Stage 1 — Site visit -->
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='visited_by']" position="attributes">
                    <attribute name="class" add=" cpabooks_fsm_stage_field_1" separator=" "/>
                    <attribute name="attrs">{'readonly': [('fsm_stage_1_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='visited_date']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_1_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='site_visit']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_1_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='next_action']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_1_readonly', '=', True)]}</attribute>
                </xpath>
                <!-- Stage 2 — Assign (employee field attrs set in fsm_timesheet_employee_views.xml) -->
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='assign_date']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_2_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='fsm_assigned_employee_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_2_readonly', '=', True)]}</attribute>
                </xpath>

                <!-- Stage 3 — Job progress -->
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='date_end']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_3_readonly', '=', True)]}</attribute>
                </xpath>

                <!-- Stage 6 — Invoice status is read-only (linked from CRN quotation) -->
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='fsm_invoice_progress_status']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_4_readonly', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='fsm_invoice_number_display']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_4_readonly', '=', True)], 'invisible': [('fsm_invoice_number_display', '=', False)]}</attribute>
                </xpath>
                <!-- Stage 5 — Close remarks -->
                <xpath expr="//group[@class='cpabooks_fsm_overview']/group[1]//field[@name='closing_remarks']" position="attributes">
                    <attribute name="attrs">{'readonly': [('fsm_stage_6_readonly', '=', True)]}</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
