<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_cpa_cd_form" model="ir.ui.view">
        <field name="name">account.move.cpa.cd.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                <attribute name="decoration-muted">cpa_cd_scratched</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="cpa_cd_scratched" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list" position="attributes">
                <attribute name="decoration-muted">cpa_cd_scratched</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <field name="cpa_cd_scratched" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
