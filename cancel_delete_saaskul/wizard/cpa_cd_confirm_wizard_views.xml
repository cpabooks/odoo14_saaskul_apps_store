<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpa_cd_confirm_wizard_form" model="ir.ui.view">
        <field name="name">cpa.cd.confirm.wizard.form</field>
        <field name="model">cpa.cd.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <field name="method_name" invisible="1"/>
                <group>
                    <field name="note" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                    <button name="action_run" type="object" string="Confirm" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
