<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_faff_completion_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>FAFF Completion / Handover Note</h2>
                        <p><strong>Document:</strong> <span t-field="o.name"/></p>
                        <p><strong>FAFF Job:</strong> <span t-field="o.job_id"/></p>
                        <p><strong>Customer:</strong> <span t-field="o.partner_id"/></p>
                        <p><strong>Site:</strong> <span t-field="o.site_name"/></p>
                        <p><strong>Completion Date:</strong> <span t-field="o.completion_date"/></p>
                        <h3>Work Completed</h3>
                        <p t-field="o.work_completed"/>
                        <h3>Material / Equipment Delivered</h3>
                        <p t-field="o.material_delivered"/>
                        <h3>Testing Result</h3>
                        <p t-field="o.testing_result"/>
                        <h3>Outstanding Items</h3>
                        <p t-field="o.outstanding_items"/>
                        <p><strong>Warranty:</strong> <span t-field="o.warranty"/></p>
                        <p t-field="o.remarks"/>
                        <div class="row mt32">
                            <div class="col-6">
                                <p><strong>Customer:</strong> <span t-field="o.customer_name"/></p>
                                <p><strong>Designation:</strong> <span t-field="o.customer_designation"/></p>
                                <p><strong>Sign Date:</strong> <span t-field="o.sign_date"/></p>
                                <t t-if="o.customer_signature">
                                    <img t-att-src="image_data_uri(o.customer_signature)" style="max-height:80px;"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
