<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="SwitchgearProcessingCycle">
        <div class="o_sg_processing_cycle_root">
            <div class="o_sg_cycle_header text-center mb-3">
                <h2>Switchgear processing cycle</h2>
                <p class="text-muted mb-0">
                    Click any step to open that screen. Flow runs clockwise from CRM enquiry through accounting.
                </p>
            </div>
            <div class="o_sg_cycle_viewport">
                <div class="o_sg_cycle_stage">
                    <div class="o_sg_cycle_center">
                        <div class="o_sg_cycle_center_title">Switchgear</div>
                        <div class="o_sg_cycle_center_sub">Full Process</div>
                    </div>
                    <div class="o_sg_cycle_ring"/>
                    <svg class="o_sg_cycle_arrow_ring" viewBox="0 0 520 520" aria-hidden="true">
                        <defs>
                            <marker id="sg_cycle_arrowhead" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
                                <polygon points="0 0, 8 4, 0 8" fill="rgba(255,255,255,0.35)"/>
                            </marker>
                        </defs>
                        <circle cx="260" cy="260" r="210" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="2" stroke-dasharray="8 10"/>
                    </svg>
                </div>
            </div>
            <div class="o_sg_cycle_legend row justify-content-center mt-4">
                <div class="col-auto"><span class="o_sg_cycle_legend_dot o_sg_cycle_theme_customer"/> Customer</div>
                <div class="col-auto"><span class="o_sg_cycle_legend_dot o_sg_cycle_theme_engineering"/> Engineering</div>
                <div class="col-auto"><span class="o_sg_cycle_legend_dot o_sg_cycle_theme_purchase"/> Purchase / Store</div>
                <div class="col-auto"><span class="o_sg_cycle_legend_dot o_sg_cycle_theme_accounting"/> Accounting</div>
            </div>
        </div>
    </t>

</templates>
