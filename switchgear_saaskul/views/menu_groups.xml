<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Visible to all internal users (not only optional Show Flowchart App group). -->
        <record id="menu_flowchart_kanban_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
        <!-- Anyone with Internal User also gets Show Flowchart App (legacy group). -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('switchgear_saaskul.group_flowchart'))]"/>
        </record>
    </data>
</odoo>
