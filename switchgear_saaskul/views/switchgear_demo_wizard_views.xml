<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_switchgear_demo_wizard_form" model="ir.ui.view">
        <field name="name">switchgear.demo.wizard.form</field>
        <field name="model">switchgear.demo.wizard</field>
        <field name="arch" type="xml">
            <form string="Switchgear demo data">
                <div class="alert alert-info" role="alert">
                    Load creates full Switchgear processing-cycle samples (CRM through accounting).
                    Clean removes demo customers, CRM stacks, and <b>DEMO-SG</b> / <b>DEMO-FN</b> products
                    for the selected company.
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="profile"/>
                    <field name="voucher_count"/>
                </group>
                <group string="Load options">
                    <field name="full_cycle"/>
                    <field name="load_timesheets"/>
                    <field name="create_pr_when_no_stock"/>
                    <field name="create_job_orders"/>
                    <field name="load_activities"/>
                </group>
                <footer>
                    <button name="action_load_demo_data" type="object"
                            string="Load Demo Data" class="btn-primary"/>
                    <button name="action_clean_demo_data" type="object"
                            string="Clean Demo Data" class="btn-danger"
                            confirm="Remove all switchgear/furniture demo stacks and demo products for this company. Continue?"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_switchgear_demo_wizard" model="ir.actions.act_window">
        <field name="name">Switchgear demo data</field>
        <field name="res_model">switchgear.demo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_profile': 'switchgear', 'default_voucher_count': 25}</field>
    </record>

</odoo>
