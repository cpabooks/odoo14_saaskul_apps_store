<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_client_letter" model="ir.ui.view">
        <field name="name">crm.lead.form.client.letter</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_client_letter_wizard"
                        type="object"
                        string="Send Client Letter"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_form_client_letter" model="ir.ui.view">
        <field name="name">sale.order.form.client.letter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_client_letter_wizard"
                        type="object"
                        string="Send Client Letter"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_form_client_letter" model="ir.ui.view">
        <field name="name">account.move.form.client.letter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_client_letter_wizard"
                        type="object"
                        string="Send Client Letter"
                        attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <record id="project_form_view_client_letter" model="ir.ui.view">
        <field name="name">project.project.form.client.letter</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_client_letter_wizard"
                        type="object"
                        string="Send Client Letter"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
