<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cafm_ppm_setup_wizard_form" model="ir.ui.view">
        <field name="name">cafm.ppm.setup.wizard.form</field>
        <field name="model">cafm.ppm.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="PPM setup">
                <group>
                    <field name="year"/>
                    <field name="scope" widget="radio"/>
                    <field name="partner_id" attrs="{'invisible': [('scope','!=','customer')]}"/>
                    <field name="project_id" attrs="{'invisible': [('scope','!=','project')]}"/>
                    <field name="location_filter"/>
                </group>
                <group string="Planning (frequency or manual months)">
                    <field name="planning_mode"/>
                    <field name="frequency" attrs="{'invisible': [('planning_mode','!=','frequency')]}"/>
                </group>
                <group string="Manual months" attrs="{'invisible': [('planning_mode','!=','manual')]}">
                    <group>
                        <field name="manual_jan"/><field name="manual_feb"/><field name="manual_mar"/><field name="manual_apr"/>
                    </group>
                    <group>
                        <field name="manual_may"/><field name="manual_jun"/><field name="manual_jul"/><field name="manual_aug"/>
                    </group>
                    <group>
                        <field name="manual_sep"/><field name="manual_oct"/><field name="manual_nov"/><field name="manual_dec"/>
                    </group>
                </group>
                <group>
                    <field name="supervisor_id"/>
                    <field name="regenerate_slots"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cafm_ppm_setup_wizard" model="ir.actions.act_window">
        <field name="name">PPM setup</field>
        <field name="res_model">cafm.ppm.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="cafm_ppm_generate_wizard_form" model="ir.ui.view">
        <field name="name">cafm.ppm.generate.wizard.form</field>
        <field name="model">cafm.ppm.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate PPM">
                <group>
                    <field name="year"/>
                    <field name="include_next_year"/>
                    <field name="only_active"/>
                    <field name="project_id"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Generate" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cafm_ppm_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate PPM</field>
        <field name="res_model">cafm.ppm.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="cafm_ppm_monthly_grid_wizard_form" model="ir.ui.view">
        <field name="name">cafm.ppm.monthly.grid.wizard.form</field>
        <field name="model">cafm.ppm.monthly.grid.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly PPM" create="false" edit="true">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="oe_highlight"/>
                    <button name="action_export_csv" type="object" string="Export CSV (Excel)"/>
                </header>
                <sheet>
                    <group>
                        <field name="year"/>
                        <field name="pending_only" readonly="1"/>
                    </group>
                    <field name="report_html" widget="cafm_readonly_html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cafm_ppm_monthly_grid_full_server" model="ir.actions.server">
        <field name="name">Monthly PPM table</field>
        <field name="model_id" ref="model_cafm_ppm_monthly_grid_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_full()</field>
    </record>

    <record id="cafm_ppm_monthly_grid_pending_server" model="ir.actions.server">
        <field name="name">Monthly PPM — pending</field>
        <field name="model_id" ref="model_cafm_ppm_monthly_grid_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pending()</field>
    </record>

    <record id="cafm_ppm_daily_list_wizard_form" model="ir.ui.view">
        <field name="name">cafm.ppm.daily.list.wizard.form</field>
        <field name="model">cafm.ppm.daily.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Technician daily PPM list">
                <group>
                    <field name="report_date"/>
                    <field name="supervisor_id"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cafm_ppm_daily_list_wizard" model="ir.actions.act_window">
        <field name="name">Daily PPM list (PDF)</field>
        <field name="res_model">cafm.ppm.daily.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
