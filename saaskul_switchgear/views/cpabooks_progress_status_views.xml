<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cpabooks_progress_status_wizard_form" model="ir.ui.view">
        <field name="name">cpabooks.progress.status.wizard.form</field>
        <field name="model">cpabooks.progress.status.wizard</field>
        <field name="arch" type="xml">
            <form string="Progress Status" class="o_cpabooks_progress_wizard">
                <sheet>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="progress_html" nolabel="1" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Shared header button on Switchgear vouchers -->
    <record id="crm_lead_form_progress_status" model="ir.ui.view">
        <field name="name">crm.lead.form.progress.status</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_cpabooks_open_progress_status" type="object"
                        string="Progress Status" class="btn-secondary o_cpabooks_progress_status_btn"
                        icon="fa-tasks"/>
            </xpath>
        </field>
    </record>

