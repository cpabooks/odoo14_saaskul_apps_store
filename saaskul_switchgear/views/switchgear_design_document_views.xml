<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_switchgear_design_document" model="ir.sequence">
        <field name="name">Switchgear Design Document</field>
        <field name="code">switchgear.design.document</field>
        <field name="prefix">SG/DES/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="switchgear_design_document_tree_view" model="ir.ui.view">
        <field name="name">switchgear.design.document.tree</field>
        <field name="model">switchgear.design.document</field>
        <field name="arch" type="xml">
            <tree string="Design Documents" default_order="date desc">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="sale_order_id"/>
                <field name="sent_count"/>
                <field name="received_count"/>
                <field name="attachment_count"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="switchgear_design_document_kanban_view" model="ir.ui.view">
        <field name="name">switchgear.design.document.kanban</field>
        <field name="model">switchgear.design.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="date desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="sent_count"/>
                <field name="received_count"/>
                <field name="attachment_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <div t-if="record.project_id.raw_value" class="text-muted">
                                    <field name="project_id"/>
                                </div>
                                <div class="mt-2">
                                    <span class="badge badge-pill badge-info mr-1">
                                        Sent: <field name="sent_count"/>
                                    </span>
                                    <span class="badge badge-pill badge-success mr-1">
                                        Received: <field name="received_count"/>
                                    </span>
                                    <span class="badge badge-pill badge-secondary">
                                        Files: <field name="attachment_count"/>
                                    </span>
                                </div>
                                <div class="text-muted mt-1">
                                    <field name="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="switchgear_design_document_form_view" model="ir.ui.view">
        <field name="name">switchgear.design.document.form</field>
        <field name="model">switchgear.design.document</field>
        <field name="arch" type="xml">
            <form string="Design Document">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="sale_order_id"/>
                            <field name="job_estimate_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Document Sent" name="document_sent">
                            <field name="sent_line_ids" nolabel="1">
                                <tree string="Documents Sent" editable="bottom">
                                    <field name="sr"/>
                                    <field name="document_name"/>
                                    <field name="date_sent"/>
                                    <field name="attachment" filename="attachment_name"/>
                                    <field name="attachment_name" invisible="1"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Document Received" name="document_received">
                            <field name="received_line_ids" nolabel="1">
                                <tree string="Documents Received" editable="bottom">
                                    <field name="sr"/>
                                    <field name="document_name"/>
                                    <field name="date_received"/>
                                    <field name="attachment" filename="attachment_name"/>
                                    <field name="attachment_name" invisible="1"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="switchgear_design_document_search_view" model="ir.ui.view">
        <field name="name">switchgear.design.document.search</field>
        <field name="model">switchgear.design.document</field>
        <field name="arch" type="xml">
            <search string="Design Documents">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="sale_order_id"/>
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today())]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Job Order" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_switchgear_design_document" model="ir.actions.act_window">
        <field name="name">Design Documents</field>
        <field name="res_model">switchgear.design.document</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="switchgear_design_document_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a design document register
            </p>
            <p>
                Track documents sent to and received from the client with file attachments,
                linked to quotations and job orders.
            </p>
        </field>
    </record>
</odoo>
